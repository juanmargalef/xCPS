 ".",
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ". Implemented formulas for ExpandVertDiff for a frozen metric"
}], "Subsection",
 CellChangeTimes->{{3.9324707187060614`*^9, 3.932470735348284*^9}, 
