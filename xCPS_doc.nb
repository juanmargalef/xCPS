Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Chapter"],
 ".",
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ". ConstantTensors"
}], "Subsection",
 CellChangeTimes->{{3.9324707187060614`*^9, 3.932470735348284*^9}, 
   3.948667428708285*^9, {3.948667658485*^9, 3.948667659305849*^9}, {
   3.948668095527338*^9, 3.948668098082294*^9}, {3.948823255409116*^9, 
   3.9488233458056254`*^9}, 3.959750058662985*^9, 
   3.959750102541399*^9},ExpressionUUID->"a2d50afc-4c1e-cb4f-94e4-\
82b37173c01c"],

Cell[TextData[{
 Cell[BoxData[
 "ConstantTensors"], "InlineCode",ExpressionUUID->
  "82eeeb9a-d37c-0049-94ac-ab9b4661cff6"],
 " is an option of ",
 Cell[BoxData[
 "VariationalRelationsOf"], "InlineCode",ExpressionUUID->
  "8e1dd853-116b-9144-ba59-ddaf05648cec"],
 " to assume some of the tensors variationally constant. Once the initial \
constant tensors have been established, the \
\[OpenCurlyDoubleQuote]constantness\[CloseCurlyDoubleQuote] is propagated as \
follows: a node is constant if all the incoming edges are constant. This \
behaviour is analogous to Equation (",
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "eq: df=chain rule"],
  FontColor->RGBColor[0., 0., 1.]],
 "). \n\nWhen the option ",
 Cell[BoxData[
 "ConstantTensors"], "InlineCode",ExpressionUUID->
  "f4a60e4d-df4b-ce4f-b1e7-3381329871c1"],
 " is used, the constant nodes are depicted as red squares (unless it is a \
green triangle, which indicates that this node is the \
\[OpenCurlyDoubleQuote]center\[CloseCurlyDoubleQuote] of the graph) and the \
edges between red squares are also drawn in red. "
}], "Text",
 CellChangeTimes->{{3.9501224221644745`*^9, 3.950122562909718*^9}, {
   3.9501226016986103`*^9, 3.950122629827724*^9}, {3.950122824801876*^9, 
   3.950122903537239*^9}, {3.950208036951872*^9, 3.9502080616070404`*^9}, {
   3.9526076921926155`*^9, 3.952607707106024*^9}, {3.9531084844126806`*^9, 
   3.9531084939953823`*^9}, 3.953108540927518*^9, {3.95788336345229*^9, 
   3.957883366864312*^9}, {3.958157690773052*^9, 3.9581577164036903`*^9}, {
   3.9597500326773834`*^9, 
   3.959750037546093*^9}},ExpressionUUID->"beb15e44-cc9b-e741-9f19-\
d9576d4a4386"],

