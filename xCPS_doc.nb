Cell[CellGroupData[{

Cell[TextData[{
 "A.",
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". Notation of complex PartialPartial tensors"
}], "Subsubsection",
 CellChangeTimes->{{3.9324707187060614`*^9, 3.932470735348284*^9}, 
   3.948667428708285*^9, {3.948667658485*^9, 3.948667720210234*^9}, {
   3.948667760620362*^9, 3.9486677778687887`*^9}, {3.948667881978399*^9, 
   3.9486679146819863`*^9}, {3.948813583792318*^9, 3.9488135843050904`*^9}, {
   3.948813911390482*^9, 3.94881402564082*^9}, {3.948814462357086*^9, 
   3.948814463767563*^9}, 3.949084608767392*^9, 3.949084789964756*^9, {
   3.9553894754447956`*^9, 3.9553894925630474`*^9}, {3.956420209795292*^9, 
   3.9564202494427185`*^9}, {3.9564203135543175`*^9, 
   3.9564203152022247`*^9}, {3.956420603238537*^9, 3.9564206060341797`*^9}, {
   3.9564222839131527`*^9, 3.9564222867681904`*^9}, {3.9584832300577354`*^9, 
   3.958483242708317*^9}, {3.9584832807860565`*^9, 3.95848328358786*^9}, {
   3.9584834068034744`*^9, 3.958483406962549*^9}, 3.9586435867580185`*^9, 
   3.9606572451269474`*^9},ExpressionUUID->"a94bb838-6baa-6149-97d3-\
f569162c1876"],

Cell[TextData[{
 "When defining ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "07869583-7b60-9948-b8fa-510e48d86d72"],
 " tensors involving complex objects, we run into a notational problem. For \
instance, the tensor:\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
 "PartialFunctionPartialVector\[Dagger]"], "InlineCode",ExpressionUUID->
  "f2a23b6b-46bf-1d4b-9ae8-f5556e693508"],
 "\n\ncan mean\n\n1.) ",
 Cell[BoxData[
  RowBox[{"Dagger", "[", 
   RowBox[{
    RowBox[{"PartialPartial", "[", "Function", "]"}], "[", "Vector", "]"}], 
   "]"}]], "InlineCode",ExpressionUUID->
  "77a34e4f-e7ca-9d4d-9f29-a8d577a67825"],
 "\n2.) ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PartialPartial", "[", "Function", "]"}], "[", 
   RowBox[{"Dagger", "@", "Vector"}], "]"}]], "InlineCode",ExpressionUUID->
  "0440df7b-93e9-6841-89fa-c660abea0067"],
 ".\n\nIf ",
 Cell[BoxData[
 "Function"], "InlineCode",ExpressionUUID->
  "88942a6f-6409-374f-bb74-b62e3875f0a8"],
 " is ",
 Cell[BoxData[
 "Real"], "InlineCode",ExpressionUUID->"55183d1e-f154-fd47-9d86-08f81f4b82be"],
 ", both expression are the same. But if ",
 Cell[BoxData[
 "Function"], "InlineCode",ExpressionUUID->
  "1d8c118a-2bea-a04c-851a-5e8988a3cfbc"],
 " is ",
 Cell[BoxData[
 "Imaginary"], "InlineCode",ExpressionUUID->
  "cd8c56c1-10a2-a148-8a28-f709828d5a6d"],
 " or ",
 Cell[BoxData[
 "Complex"], "InlineCode",ExpressionUUID->
  "af0e22b7-d902-af47-8c5f-3a1a07d9f92b"],
 ", they mean different things. To be consistent with the notation used for ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "cb62fdcd-6b88-9a4a-86f3-5d486395a3c7"],
 " on ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 ", we will assume the second option: that the \[Dagger] symbol is attached \
to the immediate object (and not the whole ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "af600586-c475-0643-93cd-611c5527a821"],
 " tensor, which would be the ",
 StyleBox["xAct",
  FontWeight->"Bold"],
 " convention)."
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, 
   3.9575468791112347`*^9, {3.957816910261736*^9, 3.9578169444384327`*^9}, {
   3.9583028973900967`*^9, 3.9583029185590076`*^9}, {3.958303281581457*^9, 
