   3.9845042497330055`*^9, 3.984504254952223*^9}, {3.9845043131388836`*^9, 
   3.984504329114176*^9}, 3.9845045001171284`*^9, 3.9845096544973946`*^9},
 TextAlignment->Center,ExpressionUUID->"868385a1-46ab-e34b-8a6c-f96d5484200b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[Phi]", "i"], "}"}], TraditionalForm]],ExpressionUUID->
  "4f64188d-ac3b-a64e-8125-ed47af2cfd05"],
 " are all the dynamical fields and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", 
    RowBox[{"(", "i", ")"}]], TraditionalForm]],ExpressionUUID->
  "d8e07143-fe54-d544-a7f1-d15784a77b5d"],
 " denote all the upper and lower indices of the field ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "i"], TraditionalForm]],ExpressionUUID->
  "2dd6a9eb-877d-2141-b4e6-c5affb38342d"],
 ". Notice that we assume that we have ",
 Cell[BoxData[
 "ChangeCovD"], "InlineCode",ExpressionUUID->
  "5109ae45-ded5-5240-9756-870c933a6509"],
 " all ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"f7f7aadb-9ae3-c64d-ac63-bcc35cd59cec"],
 " into ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "e73bdafb-7c30-7843-9468-f124080c37fe"],
 " (denoted \[Del]) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "6d949759-302b-094d-924a-a02ae27461e9"],
 " corresponds to the case of no ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"7a118f06-4341-264c-a72f-3475e34fbacc"],
 " in front of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DifferentialD]", 
    SubscriptBox["\[Phi]", "i"]}], TraditionalForm]],ExpressionUUID->
  "73a59803-c390-9544-8bd0-4f19bb4c88b3"],
 ".\n\n2. Use Leibniz rule to remove the first ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"dc8717cf-f964-454b-8daf-ae150e7773b1"],
 " in front of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DifferentialD]", 
    SubscriptBox["\[Phi]", "i"]}], TraditionalForm]],ExpressionUUID->
  "c158b3a5-aab6-fc43-aad9-58364895b62f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.953223282362236*^9, 3.9532233929486465`*^9}, {
