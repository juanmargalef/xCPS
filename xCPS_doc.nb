Cell[TextData[{
 StyleBox["xCPS",
  FontWeight->"Bold"],
 " can handle CovDs defined over inner bundles. We define an inner bundle on ",
 Cell[BoxData[
 "M"], "InlineCode",ExpressionUUID->"92a30258-4dfb-b946-8e6f-33293799279e"],
 " , a covariant derivative on ",
 Cell[BoxData[
 "M"], "InlineCode",ExpressionUUID->"6d3c47e4-6ebe-3946-b51c-5c1aeedc151c"],
 " acting also on the inner bundle and a 1-tensor with two internal indices:"
}], "Text",
 CellChangeTimes->{{3.948756485416223*^9, 3.948756511668927*^9}, {
  3.9524356884330997`*^9, 3.9524357765948706`*^9}, {3.9564090968025656`*^9, 
  3.9564091009978867`*^9}, {3.957514806240656*^9, 3.957514807965452*^9}, {
  3.958135340876892*^9, 
  3.9581353547961197`*^9}},ExpressionUUID->"a40f2c56-a24f-c144-ae95-\
4897d9c046b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "define", " ", "an", " ", "inner", " ", "bundle", " ", "on", " ",
     "M"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"DefConstantSymbol", "[", "dimeninner", "]"}], "\[IndentingNewLine]", 
   RowBox[{"DefVBundle", "[", 
    RowBox[{"inner", ",", "M", ",", "dimeninner", ",", 
     RowBox[{"{", 
      RowBox[{"J", ",", "L", ",", "P", ",", "Q"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "define", " ", "a", " ", "covariant", " ", "derivative", " ", 
     "on", " ", "M", " ", "acting", " ", "also", " ", "on", " ", "the", " ", 
     "inner", " ", "bundle"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{"DefCovD", "[", 
    RowBox[{
     RowBox[{"der2", "[", 
      RowBox[{"-", "a"}], "]"}], ",", "inner", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<;\>\"", ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"D\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"\\\\mathcal{D}\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\""}], "}"}], ",", 
     RowBox[{"Torsion", "->", "True"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"We", " ", "define", " ", "a", " ", "1"}], "-", 
     RowBox[{
     "tensor", " ", "with", " ", "two", " ", "internal", " ", "indices"}]}], 
    " ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"tensor1", "[", 
      RowBox[{"b", ",", 
       RowBox[{"-", "J"}], ",", 
       RowBox[{"-", "L"}]}], "]"}], ",", "M", ",", 
     RowBox[{"PrintAs", "->", "\"\<T\>\""}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.948756242911596*^9, 3.948756352534609*^9}, {
   3.948756398376333*^9, 3.948756468003974*^9}, {3.948757253191205*^9, 
   3.948757287061643*^9}, {3.9488045125968*^9, 3.9488045160867214`*^9}, {
   3.948806432364839*^9, 3.94880643316541*^9}, {3.948806463904316*^9, 
