Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
   Cell["", "InlineCode",ExpressionUUID->
     "4c5d3864-e196-e248-ad52-8241250cd564"], 
    RowBox[{
     RowBox[{"VariationallyConstantQ", "[", 
      RowBox[{"ListOfConstantTensors", ",", "ListOfNonConstantTensors"}], 
      "]"}], "[", "tensor", "]"}]}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"5e37940c-9f6c-2440-a1aa-fe8910c2dad3"],
 "\nIt returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"7b251299-b29e-a144-9a58-6fe01c2ae1bd"],
 " if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "69f2c005-d310-1a45-8122-4d73bd86f679"],
 " is considered variationally constant. A tensor is constant if it belongs \
to the variational influence list generated from ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"ListConstantTensors", "'"}]}]], "InlineCode",ExpressionUUID->
  "ef8be42e-a16b-384b-9fa9-de61ced5d810"],
 ", and non-constant if it is related to any tensor in ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"ListNonConstantTensors", "'"}]}]], "InlineCode",ExpressionUUID->
  "a88f2753-30c7-e04f-90e4-8603408f57f9"],
