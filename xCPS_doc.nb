graph",ExpressionUUID->"5774d96b-9999-db4f-aff1-8b6aaae262df"],

Cell[TextData[{
 "If we create an ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "f164df61-39a0-3740-a3ba-7dbe0d7e1b45"],
 " rule for a 1-vertical-form (see Subsection ",
 StyleBox[
 CounterBox["Chapter", "Sub GenerateExpandVertDiffRule"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub GenerateExpandVertDiffRule"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub GenerateExpandVertDiffRule"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub GenerateExpandVertDiffRule"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub GenerateExpandVertDiffRule"],
  FontColor->RGBColor[0., 0., 1.]],
 "), all required variational relations are also created according to the the \
ideas presented along with Equation (",
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "eq: df=chain rule"],
  FontColor->RGBColor[0., 0., 1.]],
 "). Likewise, all previous variational relations that become spurious with \
the new ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "054a1157-f6c1-b240-b56a-a1e0766617ed"],
 " rule are removed (they can be added again with ",
 Cell[BoxData[
 "AddVariationalRelation"], "InlineCode",ExpressionUUID->
  "bcd0488f-d8d1-ba4e-8b2c-54d30f5263ac"],
 ", which performs no consistency check)."
}], "Text",
 CellChangeTimes->{{3.950116875007925*^9, 3.9501168875196743`*^9}, {
   3.958158865722706*^9, 3.958158895001154*^9}, {3.958160590627514*^9, 
   3.958160602960705*^9}, {3.9581606478621254`*^9, 3.9581606802774887`*^9}, {
   3.9581609096049156`*^9, 3.9581609423226967`*^9}, {3.9581635762569923`*^9, 
   3.9581636184376335`*^9}, {3.9581636509577503`*^9, 3.9581636627890778`*^9}, 
   3.959578748333296*^9, 3.9595788543926373`*^9, {3.959750142629511*^9, 
   3.9597501503727436`*^9}, {3.960298160724478*^9, 
   3.9602982409269524`*^9}},ExpressionUUID->"bbe1695f-0215-df48-8856-\
4bf026fee49e"],

