 "A variational vector field is a scalar where each monomial has one and only \
one variational vector with no Head wrapping it (like ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"5baf579b-2513-744e-a876-a1ed392834c5"],
 ", ",
 Cell[BoxData[
 "LieD"], "InlineCode",ExpressionUUID->"7e0dd326-5875-3c42-be5c-364dc7cf5749"],
 ", ",
 Cell[BoxData[
 "ParamD"], "InlineCode",ExpressionUUID->
  "7bee6609-e956-d645-8da6-1c1f6decbe68"],
 "...). "
}], "Text",
