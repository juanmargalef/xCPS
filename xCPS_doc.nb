     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], 
      SubscriptBox["m", "i"]], 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[Del]", 
           SubscriptBox["a", "1"]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              SubscriptBox[
               SuperscriptBox[
                RowBox[{"(", 
                 SubscriptBox["T", "ij"], ")"}], 
                RowBox[{
                 RowBox[{
                  SubscriptBox["a", "1"], "..."}], 
                 SubscriptBox["a", "j"]}]], 
               SubscriptBox["B", 
                RowBox[{"(", "i", ")"}]]], 
              SubscriptBox["\[Del]", 
               SubscriptBox["a", "2"]]}], "..."}], 
            RowBox[{
             SubscriptBox["\[Del]", 
              SubscriptBox["a", "j"]], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"\[DifferentialD]", 
                SubscriptBox["\[Phi]", "i"]}], ")"}], 
              SubscriptBox["B", 
               RowBox[{"(", "i", ")"}]]]}]}], ")"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Del]", 
             SubscriptBox["a", "1"]], 
            SubscriptBox[
             SuperscriptBox[
              RowBox[{"(", 
               SubscriptBox["T", "ij"], ")"}], 
              RowBox[{
               RowBox[{
                SubscriptBox["a", "1"], "..."}], 
               SubscriptBox["a", "j"]}]], 
             SubscriptBox["B", 
              RowBox[{"(", "i", ")"}]]]}], ")"}], 
          SubscriptBox["\[Del]", 
           SubscriptBox["a", "2"]]}]}], "..."}], 
       RowBox[{
        SubscriptBox["\[Del]", 
         SubscriptBox["a", "j"]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[DifferentialD]", 
           SubscriptBox["\[Phi]", "i"]}], ")"}], 
