Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Chapter"],
 ".",
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". Sign conventions"
}], "Subsubsection",
 CellChangeTimes->{{3.9324707187060614`*^9, 3.932470735348284*^9}, 
   3.948667428708285*^9, {3.948667658485*^9, 3.948667720210234*^9}, {
   3.948667760620362*^9, 3.9486677778687887`*^9}, {3.948667881978399*^9, 
   3.9486679146819863`*^9}, {3.948813583792318*^9, 3.9488135843050904`*^9}, {
   3.948813911390482*^9, 3.94881402564082*^9}, {3.948814462357086*^9, 
   3.948814463767563*^9}, 3.949084608767392*^9, 3.949084789964756*^9, {
   3.9553894754447956`*^9, 3.9553894925630474`*^9}, {3.956420209795292*^9, 
   3.9564202107296524`*^9}, {3.958126632802889*^9, 3.958126636354912*^9}, 
   3.9606568756782093`*^9},ExpressionUUID->"8ec73b4b-6fb7-024f-a95e-\
8da1cbff1380"],

Cell[TextData[{
 "To make sure that ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 " works for any sign convention, we remove the numerical values of the \
signs. This can be achieved with ",
 Cell[BoxData[
 "SetSigns"], "InlineCode",ExpressionUUID->
  "6ccf3755-02fe-0e42-bb0e-894ab51bef6c"],
 " (see Subsection ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub Ap setsigns"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub Ap setsigns"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub Ap setsigns"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub Ap setsigns"],
  FontColor->RGBColor[0., 0., 1.]],
 " of the Appendix):"
}], "Text",
 CellChangeTimes->{{3.952434700539174*^9, 3.9524347045449486`*^9}, 
   3.952604219344743*^9, {3.957900952571909*^9, 3.9579010055219*^9}, {
   3.9580636138210163`*^9, 3.9580636252091694`*^9}, {3.9580867334972343`*^9, 
   3.9580868526970234`*^9}, {3.958390116265459*^9, 3.9583901292995586`*^9}, 
   3.95951250267708*^9, 3.959578747639776*^9, 
   3.9595788538935413`*^9},ExpressionUUID->"b8749f87-e66c-cb47-94fb-\
11829e379678"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"SetSigns", "[", "value", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"89df526d-3289-2944-9b45-9f371d87e185"],
 "\nIt fixes the value of all signs (symbols of ",
 Cell[BoxData[
 "$ConstantSymbols"], "InlineCode",ExpressionUUID->
  "4811f39b-c20b-4b49-bfad-30abd1e817fe"],
 " whose names begins with ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"$", "'"}]}]], "InlineCode",ExpressionUUID->
  "8c953baa-778e-e640-8e6b-0469ae6cf463"],
 " and ends in ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Sign", "'"}]}]], "InlineCode",ExpressionUUID->
  "ede5d531-0915-8d48-8117-0c427e17ecbd"],
 "). If ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"value", "'"}]}]], "InlineCode",ExpressionUUID->
  "5139a43f-e054-ec44-a64f-2425f914cd2d"],
 " is 1/-1, all signs are set to this value, if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"value", "'"}]}]], "InlineCode",ExpressionUUID->
  "bb121dec-1507-1b4b-b3e1-70996792d1df"],
 " is 0, all signs are unset."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
   3.953086717072216*^9, 3.953086744422722*^9}, 3.9544805056591763`*^9, {
