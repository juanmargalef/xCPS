Cell[TextData[{
 "We saw on Section ",
 StyleBox[
 CounterBox["Chapter", "section expandVertInt"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"section expandVertInt"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "section expandVertInt"],
  FontColor->RGBColor[0., 0., 1.]],
 " and Subsection ",
 StyleBox[
 CounterBox["Chapter", "sub covd and expandvertint"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub covd and expandvertint"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub covd and expandvertint"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub covd and expandvertint"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub covd and expandvertint"],
  FontColor->RGBColor[0., 0., 1.]],
 " how ",
 Cell[BoxData[
 "ExpandVertInt"], "InlineCode",ExpressionUUID->
  "3b715422-7314-cb45-8f66-cda76639efd6"],
 " deals with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertInt", "[", "vvf", "]"}], "[", "expr", "]"}]], "InlineCode",
  ExpressionUUID->"2da21777-806f-ab43-bccf-9a37d3d78146"],
 " when ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "f6b174ac-c8cc-1942-94ef-c21c809ad58c"],
 " contains ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"65fda378-680d-dd49-9ce3-d3042cfb8606"],
 ", ",
 Cell[BoxData[
 "Lied"], "InlineCode",ExpressionUUID->"8ecc4420-26c1-e64d-8838-2db2a52826af"],
 ", and ",
 Cell[BoxData[
 "Bracket"], "InlineCode",ExpressionUUID->
  "67690551-6422-6249-a58a-f04caf90ae8a"],
 ". This was true for an abstract variational vector ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "b012cbb3-a2ca-b645-82d2-ef3434a43a91"],
 ". However, if ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VVFQ", "[", "vvf", "]"}], "=", "True"}]], "InlineCode",
  ExpressionUUID->"384f3d0d-f547-2e44-8774-74d7fbc42d66"],
 ", we have additional information. By definition, it acts as follows \
(assuming indices in their natural place):"
}], "Text",
