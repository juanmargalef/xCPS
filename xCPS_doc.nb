   3.9845048512600594`*^9}, {3.9845049870920906`*^9, 
   3.9845049870920906`*^9}},ExpressionUUID->"9ac6c73d-a2db-ec45-904f-\
93da5f28c623"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      SubscriptBox["m", "i"]], 
     RowBox[{
      SubscriptBox[
       SuperscriptBox[
        RowBox[{"(", 
         SubscriptBox["T", "ij"], ")"}], 
        RowBox[{
         RowBox[{
          SubscriptBox["a", "1"], "..."}], 
         SubscriptBox["a", "j"]}]], 
       SubscriptBox["B", 
        RowBox[{"(", "i", ")"}]]], 
      SubscriptBox["\[Del]", 
       SubscriptBox["a", "1"]]}]}]}], "..."}], 
  RowBox[{
   SubscriptBox["\[Del]", 
    SubscriptBox["a", "j"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[DifferentialD]", 
      SubscriptBox["\[Phi]", "i"]}], ")"}], 
    SubscriptBox["B", 
     RowBox[{"(", "i", ")"}]]]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.953223387695833*^9, 3.9532235359947433`*^9}, {
   3.953223579402294*^9, 3.953223626437525*^9}, {3.9532240848832073`*^9, 
   3.9532240859984264`*^9}, {3.9532258595141964`*^9, 3.953225864106159*^9}, {
   3.9532259466362057`*^9, 3.9532259498070164`*^9}, 3.953225990318386*^9, {
   3.953226068376135*^9, 3.953226070674341*^9}, 3.9575398274018803`*^9, {
