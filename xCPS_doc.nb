Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", 
    RowBox[{"P", ",", "Q"}], "]"}], "=", 
   RowBox[{"PQ", "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"VertDeg", "[", "P", "]"}], 
       RowBox[{"VertDeg", "[", "Q", "]"}]}]], "QP"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.950271096009472*^9, 3.9502710991455173`*^9}, {
   3.957531656745186*^9, 3.9575316641004257`*^9}, {3.9581287048144665`*^9, 
   3.958128725673641*^9}, {3.9581287717938805`*^9, 3.9581288749795303`*^9}, 
   3.983626878134285*^9, {3.9836269097243595`*^9, 3.983626925900055*^9}},
 TextAlignment->Center,ExpressionUUID->"e892267c-a5f4-ae4f-a32c-4efa59a4d4e7"],

Cell["\<\
we have 6 possible super-commutators between the operators \
\[DoubleStruckCapitalL], \[ImaginaryI], and \[DifferentialD]. Under the \
correct hypothesis of the vector fields, their result can be written in terms \
of {\[DoubleStruckCapitalL], \[ImaginaryI], \[DifferentialD]}:\
