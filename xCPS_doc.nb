Cell[TextData[{
 Cell[BoxData[
 "ExpandVertInt"], "InlineCode",ExpressionUUID->
  "745b4c23-8768-5846-b700-b6d6484c5ebb"],
 " is analogous to ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "9a178476-6b1d-a945-81b7-a3d72140221d"],
 " for ",
