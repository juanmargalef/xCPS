Cell[TextData[{
 "Variational vector fields only know how to act over ",
 Cell[BoxData[
 "dltensors"], "InlineCode",ExpressionUUID->
  "3a2924ed-0011-4546-a62e-6b4f276997e7"],
 ". If we want to define a ",
 Cell[BoxData[
 "VVF"], "InlineCode",ExpressionUUID->"bbe2b5c3-85a7-9b40-80ca-0761a7417e15"],
 " over any vertical k-form, we need to define a Generalized Variational \
Vector Field (",
 Cell[BoxData[
 "GeneralizedVVF"], "InlineCode",ExpressionUUID->
  "50446fb6-e5a3-774f-a499-26d6db153977"],
 ")."
}], "Text",
 CellChangeTimes->{{3.9496860752106705`*^9, 3.949686154584783*^9}, {
   3.9501143581470146`*^9, 3.9501143636898823`*^9}, {3.95011453243005*^9, 
   3.9501145344223747`*^9}, {3.951861799557005*^9, 3.9518618269157734`*^9}, {
   3.952607121783599*^9, 3.9526071274487953`*^9}, 3.9564096805879307`*^9, {
   3.9581544820955315`*^9, 
   3.958154489236742*^9}},ExpressionUUID->"aa332ea8-8a08-e447-8b79-\
972b408ca310"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"DefGeneralizedVVF", "[", 
     RowBox[{"gvvf", ",", " ", "options"}], "]"}], "[", "pairs", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"c4b31803-764e-1b4d-ab60-baa006d58b9e"],
 StyleBox["\n",
  FontSize->5],
 "It defines a generalized variational vector field (GVVF) as a list of \
replacements for k-vertical-forms.\n",
 StyleBox["\n",
  FontSize->3],
 "- Option:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"VanishOverOtherForms", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"fe27191e-61cb-8e40-a2e4-c77e82f17b68"],
 ": ",
 Cell[BoxData[
  RowBox[{"VertInt", "[", "gvvf", "]"}]], "InlineCode",ExpressionUUID->
  "ae5e157b-53ad-d042-bf22-75f7f7886b14"],
 " applied to k-forms not appearing on ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"gvvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "7f4838d5-af5c-ff4f-9b33-355f0d84462c"],
 " are zero upon using ",
 Cell[BoxData[
  RowBox[{"ExpandVertInt", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a4861799-5b21-954e-abfc-5278f6abe0c3"],
 ".\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"UndefGeneralizedVVF", "[", "gvvf", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"89dd7648-2126-bf45-9427-0ec9e45f11e3"],
 "\nIt undefines the previously defined generalized variational vector field ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"gvvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "fbbe8300-373d-9b4c-8ae2-c744a6417342"],
 "."
}], "Text",
