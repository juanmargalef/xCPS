  RowBox[{"dltensor", "\[RightArrow]", "expansion"}]], "InlineCode",
  ExpressionUUID->"c9fa31b2-0737-9d4b-827b-487084fa6072"],
 " for ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dltensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "ac5bb966-78ce-5c46-9cad-52a764e611a9"],
 " to be used by ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "fd7cadba-d0b9-aa4a-b918-b4412581c2e7"],
 ".\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"RemoveExpandVertDiffRule", "[", "dltensor", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"9ddfe8c9-9405-6044-ad49-f75b3956496c"],
 " \nIt removes the expansion rule applied to ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dltensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "29e5ce36-22db-d24c-80aa-05e937938698"],
 ". It cannot be used on predefined expansion rules defined within ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 "."
}], "Text",
