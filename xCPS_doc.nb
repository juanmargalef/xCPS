Cell[TextData[{
 "This command defines internally the tensors ",
 Cell[BoxData[
 "LCDerphi"], "InlineCode",ExpressionUUID->
  "66628b19-0e92-b544-9a6d-6e1edac76664"],
 " and ",
 Cell[BoxData[
 "LCDerLCDerphi"], "InlineCode",ExpressionUUID->
  "8015327f-6826-774d-a15a-7507a59c8fe0"],
 " together with their ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "93bb199f-f9ee-fd4e-a76b-ee346953eab2"],
 " and ",
 Cell[BoxData[
 "VariationalVector"], "InlineCode",ExpressionUUID->
  "41ee6cbf-161a-064e-9917-7f536136c3c2"],
 " (see Section ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"Section Ap Imploded tensors"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Section Ap Imploded tensors"],
  FontColor->RGBColor[0., 0., 1.]],
 " of the Appendix for further details of the interaction between ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 " and ",
 Cell[BoxData[
 "Implode"], "InlineCode",ExpressionUUID->
  "21960a88-9024-1a4e-9d10-151ea0c04c35"],
 "). The new tensors\[CloseCurlyQuote] names are just the concatenation of \
their elements:"
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, 
