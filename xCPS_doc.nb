Cell[TextData[{
 "Sometimes the expressions are not immediately zero but they are after \
applying some functions (see below the case for ",
 Cell[BoxData[
  StyleBox["vvf2",
   FontColor->RGBColor[0., 0., 0.]]], "InlineCode",ExpressionUUID->
  "60acabbd-e34a-0e4d-8dba-c5e19186d8b0"],
 " ). If the user is convinced that this is not zero (as it is the case), one \
can add the option ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"CheckZero", "\[RightArrow]", "True"}],
   FontColor->RGBColor[0., 0., 0.]]], "InlineCode",ExpressionUUID->
  "1161e879-ec5e-5f4a-9841-0923216299ce"],
 " which uses ",
 Cell[BoxData[
  StyleBox["===",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",
  FontColor->RGBColor[0., 0., 0.],ExpressionUUID->
  "e437f126-ea69-8045-b76e-c86a380b6f2c"],
 StyleBox[" ",
  FontColor->RGBColor[0., 0., 0.]],
 "instead of ",
 Cell[BoxData[
  StyleBox["==",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",
  FontColor->RGBColor[0., 0., 0.],ExpressionUUID->
  "7291948f-2edf-fc4e-a9b7-79a5b8b1f868"]
}], "Text",
