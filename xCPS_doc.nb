Cell[TextData[{
 "We have introduced ",
 Cell[BoxData[
 "NormalOfCovD"], "InlineCode",ExpressionUUID->
  "cc5ee928-f85e-1d4b-9c3a-160adbabbbce"],
 " and ",
 Cell[BoxData[
 "TotalDerivativeOfCovD"], "InlineCode",ExpressionUUID->
  "601b16bc-8471-6045-bc53-f48429ed853d"],
 " in Subsubsection ",
 StyleBox[
 CounterBox["Chapter", "SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsubsection", "SubsubTotalDerivativeOfCovD and NormalOfCovD"],
  FontColor->RGBColor[0., 0., 1.]],
 ". In both cases, we mentioned that some care is needed when using ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"33d6586d-480f-624e-a5ad-f5f36ca611a3"],
 ", since it is defined over every manifold. If only one manifold is defined, \
there is no problem:"
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, {
