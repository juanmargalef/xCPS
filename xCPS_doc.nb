Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Remark:",
  FontWeight->"Bold"],
 " We have seen that if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "809b5ae1-01af-354e-b2d0-0e3985eaec6b"],
 " is a Noether symmetry, then we have a symmetry potential ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "vvf"], TraditionalForm]],ExpressionUUID->
  "a65e3439-74fe-5745-9b84-0534a71727e5"],
 " satisfying Equation (",
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "eq: LL_vvfL=dS 2"],
  FontColor->RGBColor[0., 0., 1.]],
 "). Moreover, if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "6c2a682d-3596-454a-b050-5064d0f64ad8"],
 " is defined through the Lie derivative (",
 Cell[BoxData[
 "VVFFromLieD"], "InlineCode",ExpressionUUID->
  "fd825b9d-b048-cf4b-86b7-a1976be43759"],
 "), then according to Equation (",
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "eq: LL_{XX_xi}L=L_xiL 2"],
  FontColor->RGBColor[0., 0., 1.]],
 "), we could have taken ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "vvf"], "=", 
    RowBox[{
     SubscriptBox["i", "\[Xi]"], "L"}]}], TraditionalForm]],ExpressionUUID->
  "250de032-7622-6943-b5a0-b219fbe4fc83"],
 "."
}], "Item",
 CellChangeTimes->{
