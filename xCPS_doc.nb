Cell[TextData[{
 "If we consider scalar functions that depend on tensors, we can still use \
the chain rule as we saw in Subsection ",
 StyleBox[
 CounterBox["Chapter", "sub property chain rule VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub property chain rule VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub property chain rule VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub property chain rule VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub property chain rule VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 ". However, in that case the function only depended on scalar tensors. If \
indices are present, things are much trickier but this is one of the most \
important features of ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.956421145907978*^9, 3.956421208141691*^9}, {
   3.956670847142968*^9, 3.9566708776065392`*^9}, {3.9575077804084845`*^9, 
