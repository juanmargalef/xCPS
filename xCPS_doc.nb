Cell[BoxData[
 RowBox[{"NoetherCurrentLEMwithAvvf1", "=", 
  RowBox[{
   SqrtBox[
    RowBox[{"-", 
     InterpretationBox[
      StyleBox[
       OverscriptBox["g", 
        OverscriptBox[
         StyleBox["~",
          FontColor->RGBColor[0, 0, 0]], 
         StyleBox["~",
          FontColor->RGBColor[0, 0, 0]]]],
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`Detg[],
      Editable->False]}]], 
   InterpretationBox[
    StyleBox[GridBox[{
       {
        RowBox[{
         SubscriptBox[
          RowBox[{"(", "n"}], "\[Del]"], ")"}], 
        StyleBox[GridBox[{
           {" "},
           {"a"}
          },
          GridBoxSpacings->{"Columns" -> {
              Offset[0.], {
               Offset[0.034999999999999996`]}, 
              Offset[0.]}, "Rows" -> {{
               Offset[0.]}}}],
         FontSize->Rational[39, 4]]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Center}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.034999999999999996`]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     ShowAutoStyles->False,
     AutoSpacing->False],
    $CellContext`NormalOfLCDer[-$CellContext`a],
    Editable->False], " ", 
   FormBox[
    RowBox[{
     SubscriptBox["\[Del]", "b"], 
     SuperscriptBox["T", "ab"]}],
    TraditionalForm], " ", 
   RowBox[{"(", 
    RowBox[{"on", "-", "shell"}], ")"}]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.9582486159748383`*^9, 3.958248630340519*^9}, 
   3.9582504344884777`*^9},
 TextAlignment->Center,ExpressionUUID->"de55620e-4024-e740-a865-45404b01907a"],

Cell[TextData[{
 "for some antisymmetric tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "ab"], TraditionalForm]],ExpressionUUID->
  "700e97dc-c435-b94a-8280-b95ee7fe906d"],
 " (in this case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", "ab"], "=", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       RowBox[{"-", 
        InterpretationBox[
         StyleBox[
          OverscriptBox["g", 
           OverscriptBox[
            StyleBox["~",
             FontColor->RGBColor[0, 0, 0]], 
            StyleBox["~",
             FontColor->RGBColor[0, 0, 0]]]],
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`Detg[],
         Editable->False]}]]}], 
     SuperscriptBox["\[Lambda]F", "ab"]}]}], TraditionalForm]],ExpressionUUID->
  "eecdaa0a-5832-e44f-b6aa-fdca2edffe8f"],
 "). It is easy to see that when restricted to a Cauchy surface (where",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       RowBox[{"(", "n"}], "\[Del]"], ")"}], 
     StyleBox[GridBox[{
        {"a"},
        {" "}
       },
       GridBoxSpacings->{"Columns" -> {
           Offset[0.], {
            Offset[0.034999999999999996`]}, 
           Offset[0.]}, "Rows" -> {{
            Offset[0.]}}}],
      FontSize->Rational[39, 4]]}
   },
   GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Center}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[0.034999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}]],
  CellChangeTimes->{{3.9551010099463196`*^9, 3.9551010408666935`*^9}, {
   3.9551010810547714`*^9, 3.955101275954441*^9}, {3.9554511092241974`*^9, 
   3.955451167859661*^9}, {3.955456909936985*^9, 3.9554569107965527`*^9}, {
   3.955457314146557*^9, 3.9554573502021465`*^9}},ExpressionUUID->
  "a722d7dc-a293-9241-9d8f-83f7f832fe63"],
 " turns into its unitary normal vector field), ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"NoetherCurrentLEMwithAvvf1", "'"}]}]], "InlineCode",
  ExpressionUUID->"80fd9310-2b1c-7f4d-9c5b-aa4f9002c197"],
 " is a divergence with respect to the induced Levi-Civita connection. Thus, \
the charged associated with ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf1", "'"}]}]], "InlineCode",ExpressionUUID->
  "b413a027-9a31-014a-a71e-4450589e3ecf"],
 ", which is obtained integrating ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"NoetherCurrentLEMwithAvvf1", "'"}]}]], "InlineCode",
  ExpressionUUID->"3dfa831d-be15-e244-b172-6f34ce4c84bb"],
 " over a Cauchy surface (without boundary), vanishes.\n\nWe can of course \
explicitly check that ",
 Cell[BoxData[
 "NoetherCurrentLEMwithAvvf1"], "InlineCode",ExpressionUUID->
  "294613e6-16c0-ab4a-83de-b5915ddfa383"],
 " is the Hamiltonian function of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf1", "'"}]}]], "InlineCode",ExpressionUUID->
  "c9c35a66-6623-1f4a-a0dd-15c0d270ec53"],
 ":"
}], "Text",
 CellChangeTimes->{{3.954949541405796*^9, 3.954949622558178*^9}, {
   3.95510151305056*^9, 3.955101567545923*^9}, {3.9554573664921703`*^9, 
