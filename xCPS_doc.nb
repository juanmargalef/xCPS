   3.959575447523245*^9}},
 Background->RGBColor[
  1, 0.882353, 
   0.823529],ExpressionUUID->"820a66c6-3ae5-084b-b8db-a0568938078e"],

Cell[TextData[{
 "Remember that ",
 Cell[BoxData[
 "VertDeg"], "InlineCode",ExpressionUUID->
  "84f6d00e-98b9-2642-a4f7-01cdc23e05e6"],
 " is well defined for monomials but it might not be for sums of monomials."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9523852976087427`*^9, 3.952385322088783*^9}, 
