Cell[TextData[{
 "Recall from Subsection ",
 StyleBox[
 CounterBox["Chapter", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 ", that when metrics are involved, two ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "1161098b-3257-904b-9f5b-1bf52fc43ef4"],
 " tensors are defined (one with the metric and another with the inverse). \
Likewise, when complex tensors are involved, two ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "d4c2119f-0415-a648-a67d-71e5860a22c8"],
 " tensors are defined (one with the tensors and another with their \
conjugates). Thus, when both metrics and complex tensors are involved, four ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "7817062b-b643-724e-b5ad-700cdc59b16c"],
 " tensors are defined:"
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
