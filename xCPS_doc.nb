Cell[TextData[{
 Cell[BoxData[
  StyleBox["$PartialPartialTensors",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"1f9f6608-11da-a747-bef0-ab11685e63fe"],
 "\nIt is a global variable that stores all tensors defined as partial \
derivatives of scalar functions with respect to other tensors, i.e. those \
created via ",
 Cell[BoxData[
 "DefPartialPartial"], "InlineCode",ExpressionUUID->
  "d251fe61-6030-8445-95c6-6ac4c7633b56"],
 "."
}], "Text",
