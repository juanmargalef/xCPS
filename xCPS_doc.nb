Cell[TextData[{
 "The variational vector associated with ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "d5e453b3-5275-0c47-84c4-3f108cf7a8bf"],
 " is the dual of ",
 Cell[BoxData[
  RowBox[{"VertDiff", "[", "tensor", "]"}]], "InlineCode",ExpressionUUID->
  "f9ac4b36-819b-3447-a56c-5444989f9662"],
 ". Thus, the latter can act on the former (and conversely) to obtain a \
scalar function. This implies that, as we will see in the following, the \
character of the variational vector must be opposite to ",
 Cell[BoxData[
  RowBox[{"VertDiff", "[", "tensor", "]"}]], "InlineCode",ExpressionUUID->
  "42769ae2-311b-6f40-b585-c076ea66d4f3"],
 " (indices, ",
 Cell[BoxData[
 "WeightOfTensor"], "InlineCode",ExpressionUUID->
  "36487149-90d7-6a44-8696-7fe172aae843"],
 ", ",
 Cell[BoxData[
 "VertDeg"], "InlineCode",ExpressionUUID->
  "09c150f7-181b-e949-b845-b08a28a3b043"],
 "...)."
}], "Text",
 CellChangeTimes->{{3.948847976168219*^9, 3.9488480564419847`*^9}, {
   3.9498799579887104`*^9, 3.949879963150984*^9}, {3.9502736222107887`*^9, 
