Cell[TextData[{
 "When a non-frozen metric is created,",
 StyleBox[" xCPS",
  FontWeight->"Bold"],
 " automatically creates two tensors: ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dlmetric", "'"}]}]], "InlineCode",ExpressionUUID->
  "f245d3e9-6577-934e-8c18-a9924329157c"],
 " and ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dlInvmetric", "'"}]}]], "InlineCode",ExpressionUUID->
  "f1204c3a-a758-7041-926c-5e76c811165e"],
 ". Then, any appearance of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dlInvmetric", "'"}]}]], "InlineCode",ExpressionUUID->
  "11fa26e6-364c-554d-af3b-e30f32bcf1ab"],
 " is exchanged by ",
 Cell[BoxData[
  RowBox[{"-", "dlmetric"}]], "InlineCode",ExpressionUUID->
  "a56c084d-1aec-ab42-a0d3-c5c429ec9b02"],
 " without using ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "73d41d33-ca17-9044-86a3-806e738560eb"],
 " to avoid certain problems in other functions that are explained afterwards."
}], "Text",
 CellChangeTimes->{{3.9524359425316486`*^9, 3.952435968076642*^9}, 
   3.954761557524143*^9, {3.9555275596472335`*^9, 3.95552755994924*^9}, {
