Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"VertLie", "[", "vvf", "]"}], "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"a8c8a4e4-2b07-ab4d-89f6-00436354c690"],
 "\nIt returns the vertical Lie derivative of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "7c2fdbdb-3513-904c-9ec2-79f72075a80a"],
 " along the variational vector field",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "9dd9120f-9292-0740-ae63-fa4910b6e2cf"],
 ". ",
 Cell[BoxData[
  RowBox[{"VertLie", "[", "vvf", "]"}]], "InlineCode",ExpressionUUID->
  "3cf00662-7040-0045-ba4b-53c08340a72c"],
 " is a graded derivation of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", 
    RowBox[{"VertLie", "[", "vvf", "]"}], "]"}], "=", 
   RowBox[{"VertDeg", "[", "vvf", "]"}]}]], "InlineCode",ExpressionUUID->
  "0189c0c5-2f5e-8d42-b213-db7a34a9469c"],
 ". We denote it with the symbol \[DoubleStruckCapitalL] (\[EscapeKey]+dsL+\
\[EscapeKey])."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
   3.953086717072216*^9, 3.953086744422722*^9}, 3.9544805056591763`*^9, {
   3.954505009170573*^9, 3.954505022966942*^9}, {3.954649773421836*^9, 
   3.9546497859023123`*^9}, {3.95465114842006*^9, 3.954651157760322*^9}, 
   3.9546666442743835`*^9, {3.9546666763861275`*^9, 3.9546666786754775`*^9}, 
   3.954667050909913*^9, {3.9546673224456263`*^9, 3.954667324505703*^9}, {
   3.955366734584505*^9, 3.9553667350872173`*^9}, {3.9553670403332872`*^9, 
   3.955367064545021*^9}, {3.955949371532874*^9, 3.9559493750563035`*^9}, {
   3.956916100125054*^9, 3.956916140246871*^9}, {3.9569163507577844`*^9, 
   3.956916359818827*^9}, {3.957396612938471*^9, 3.957396615721898*^9}, {
   3.9573972177785363`*^9, 3.957397250545246*^9}, {3.9573974201342783`*^9, 
   3.95739742094497*^9}, 3.9578836825038166`*^9, {3.9578854780339146`*^9, 
   3.957885510390124*^9}, 3.957957464250618*^9, {3.9580431831501255`*^9, 
   3.958043229301193*^9}, {3.958082679086708*^9, 3.958082703597309*^9}, {
   3.9581283038751373`*^9, 3.9581283044484634`*^9}, {3.9581311339793625`*^9, 
   3.9581311468322945`*^9}, {3.9581313744498425`*^9, 
   3.9581313813480453`*^9}, {3.959575452767851*^9, 3.9595754560569*^9}},
 Background->RGBColor[
  1, 0.882353, 
   0.823529],ExpressionUUID->"a5d9e2e2-4275-9143-adc5-34c3b89d686c"],

Cell[TextData[{
 "One must to be careful because the standard Cartan\[CloseCurlyQuote]s magic \
formula, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["X", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["i", "TI"], 
          StyleBox["X", "TI"]], 
         StyleBox["d", "TI"], "+", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["i", "TI"], 
          StyleBox["X", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L_X=i_X d+di_X", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a42d2e1b-b453-fe46-b038-7ecb290d2d80"],
 ", and the commutativity of the Lie derivative and the exterior derivative, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["X", "TI"]], 
         StyleBox["d", "TI"], "\[LongEqual]", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["X", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L_X d=d L_X", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "35927d04-0c55-7f42-97ca-9d21d94d4bcc"],
 ", are not true in general for vertical operators (it is only true if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "cc59577a-3c74-3040-9ac6-604330e1fe36"],
 " is the prolongation of an evolutionary vector field, see prop. 1.16, \
corollary 1.17,\.08 proposition 3.17, corollary 3.26 of [",
 StyleBox[
 CounterBox["ItemNumbered", "bibliography Anderson"],
  FontColor->RGBColor[1., 0.2901960784313726, 0.2901960784313726]],
 "])."
}], "Text",
 CellChangeTimes->{
  3.9523857466837683`*^9, {3.953090661685252*^9, 3.953090661687257*^9}, {
   3.9555265275006356`*^9, 3.955526550094337*^9}, {3.957397390772997*^9, 
   3.957397403926279*^9}, 3.957494957694563*^9, {3.9574951928332605`*^9, 
   3.9574951945873356`*^9}, {3.9580829852234554`*^9, 
   3.958082987056999*^9}},ExpressionUUID->"da072b10-769c-b847-a7e1-\
36326a28e60c"],

