 Cell[BoxData["ExpandVertDiff"], "InlineCode",
  FontColor->RGBColor[0., 0., 0.],ExpressionUUID->
  "e47d9061-93d8-c84d-852e-c4d23e72eef6"],
 " allows to generate formulas to expand ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dltensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "cc97f397-de82-5c42-9135-7a183cba08a4"],
 " in terms of other tensors."
}], "Text",
 CellChangeTimes->{{3.9523863666725693`*^9, 3.9523863733589716`*^9}, 
   3.9525601484182653`*^9, 3.952560185421962*^9, {3.9566214678248396`*^9, 
