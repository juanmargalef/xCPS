Cell[TextData[{
 Cell[BoxData[
  RowBox[{"ChangeCurvature", "[", 
   RowBox[{"expr", ",", "der1", ",", "der2"}], "]"}]], "InlineCode",
  ExpressionUUID->"9ce0ab91-ec53-174b-b23d-6cded8c4d10c"],
 " rewrites all instances of curvature tensors of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der1", "'"}]}]], "InlineCode",ExpressionUUID->
  "033fb168-f4c4-5547-8a72-0fbbfc41c532"],
 " in terms of curvature tensors of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der2", "'"}]}]], "InlineCode",ExpressionUUID->
  "d662a104-4be6-f04f-aef0-8404a53337e5"],
 " and ",
 Cell[BoxData[
  RowBox[{"Christoffel", "[", 
   RowBox[{"der1", ",", "der2"}], "]"}]], "InlineCode",ExpressionUUID->
  "dec43e20-43f9-6548-861f-1172ea839418"],
 ". As before, ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der2", "'"}]}]], "InlineCode",ExpressionUUID->
  "905bd9b0-0999-1844-a6cc-cc6212ffd54e"],
 " is taken as ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"caaeb64f-38c2-3445-8b78-fcc33ac117aa"],
 " if not provided (recall that ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"aafbf9de-b82e-0b4e-9e8c-c27d9644d1d4"],
 " has all curvature tensors equal to ",
 Cell[BoxData[
 "Zero"], "InlineCode",ExpressionUUID->"a8b67e15-bd12-024f-827a-2825e12c513e"],
 "). If ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der1", "'"}]}]], "InlineCode",ExpressionUUID->
  "4de36440-a4d8-3043-8818-9229b6ffffd2"],
 " is not provided, all curvature tensors are transformed."
}], "Text",
