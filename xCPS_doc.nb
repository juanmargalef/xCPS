Cell[TextData[{
 Cell[BoxData[
  StyleBox["NonZeroVertDeg",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"f55fab8a-3d11-0d4a-af14-6f1bb00e9a2a"],
 "\nIt is a type that represents tensors with nonzero vertical degree.\n\n",
 Cell[BoxData[
  StyleBox["ZeroVertDeg",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"a41b9a36-f193-4944-9870-29cc1ad4e531"],
 "\nIt is a type that represents tensors with vertical degree equal to zero.\n\
\n",
 Cell[BoxData[
  StyleBox["VertDiffExact",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"276b8dcf-c4b7-a542-86c3-51b9f6156c2b"],
 "\nIt is a type that represents tensors which are exact under vertical \
differentiation.\n\n",
 Cell[BoxData[
  StyleBox["NormalOfPD",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"89a157e8-0187-0942-90d5-7a799a6e1eab"],
 "\nIt is a type that represents fiducial normals defined from partial \
derivatives (",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"68fd7bd8-6610-4647-ad63-1081ad110c80"],
 ").\n\n",
 Cell[BoxData[
  StyleBox["NormalOfCovD",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"2e15d9da-a353-294c-a8f7-bf1d71f95bf0"],
 "\nIt is a type that represents fiducial normals defined from CovD.\n\n",
 Cell[BoxData[
  StyleBox["PartialPartial",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"2c72b340-7ff3-e048-9a65-71d1c3483467"],
 "\nIt is a type that represents tensors defined as partial derivatives of \
scalar functions with respect to other tensors (see ",
 StyleBox[
 CounterBox["Chapter", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[".",
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[".",
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 ")"
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
