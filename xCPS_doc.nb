Cell[TextData[{
 Cell[BoxData[Cell[TextData[StyleBox["ExpandVertInt[options][expr]",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
   "InlineCode",ExpressionUUID->"83086910-c265-cf42-9222-76fe65b5521e"]], 
  "InlineCode",ExpressionUUID->"8d13ee3a-f57b-264e-862d-16de59ac5bc2"],
 "\nIt expands the vertical interior products appearing in ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "00a0790d-75ba-9b4d-92a2-267d84e40bcd"],
 ".\n",
 StyleBox["\n",
  FontSize->5],
 "The possible options are the following:\n  \:2217 Same options as ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "df08b74c-4f0c-6c40-aa68-a9d6a1c5058c"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertIntCovD", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"5bce21bc-0e20-0a4f-bdf8-4268d815efca"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertIntLieD", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"d470b0eb-9263-3e40-b1ec-f79e8937060e"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertIntBrackets", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"c9e36645-69c5-9841-8761-ae21028b5bf9"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertIntTotalDerivative", "\[RightArrow]", "True"}]], 
  "InlineCode",ExpressionUUID->"735d7e38-c641-4c4c-b830-2f6a0be716a9"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"HoldExpandVertInt", "\[RightArrow]", 
   RowBox[{"None", "."}]}]], "InlineCode",ExpressionUUID->
  "f6c18b5d-0be4-3e43-bb3a-63586189173b"]
}], "Text",
