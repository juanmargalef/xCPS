Cell[TextData[{
 "We consider a variational vector field ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf", "'"}]}]], "InlineCode",ExpressionUUID->
  "87045630-95a0-dd46-ada6-1f70a5c4567a"],
 " (briefly explained in Subsection ",
 StyleBox[
 CounterBox["Chapter", "Sub Symmetries"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub Symmetries"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub Symmetries"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
