   3.9580866575406647`*^9}},ExpressionUUID->"2973969e-e6d7-fc4b-bc2a-\
c3bf995e385d"],

Cell[TextData[{
 "If we define a tensor with indices on a complex vector bundle, ",
 Cell[BoxData[
 "DefTensor"], "InlineCode",ExpressionUUID->
  "478bd66f-b117-0643-9304-cc56341b7368"],
 " generates also its complex conjugate (with indices in the complex \
conjugate bundle, thus the complex indices are conjugated)."
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, 
   3.9575468791112347`*^9, {3.957816910261736*^9, 3.9578169444384327`*^9}, {
   3.9583028973900967`*^9, 3.9583029185590076`*^9}, {3.958303281581457*^9, 
   3.95830335453594*^9}, {3.958305234450102*^9, 3.9583052349551506`*^9}, {
   3.9583179017867775`*^9, 3.9583179027739944`*^9}, {3.9583179714699287`*^9, 
   3.95831803689489*^9}, {3.9583180893925915`*^9, 3.9583181539431305`*^9}, {
   3.9583182651258717`*^9, 3.9583182833281956`*^9}, {3.9583191724664745`*^9, 
   3.9583191838321114`*^9}, {3.9584269322027473`*^9, 
   3.9584269386201744`*^9}},ExpressionUUID->"de7f63bd-8a51-634d-b56b-\
c6fdcc7dd318"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Remark:",
  FontWeight->"Bold"],
 " Tensors with indices in a complex vector bundle cannot be ",
 Cell[BoxData[
 "Real"], "InlineCode",ExpressionUUID->"9e7274d6-65c4-6947-98f0-ee0e0c1648c5"],
 " (default) nor ",
 Cell[BoxData[
 "Imaginary"], "InlineCode",ExpressionUUID->
  "c26b9dd3-8b92-c641-b60c-200a74f696f7"],
 ", they must be ",
 Cell[BoxData[
 "Complex"], "InlineCode",ExpressionUUID->
  "fa3cce65-538e-b44f-a0e1-6094ff0fed44"],
 " (",
 Cell[BoxData[
 "Hermitian"], "InlineCode",ExpressionUUID->
  "6102747b-799f-ce41-b9c9-91aeebb9f8de"],
 " or ",
 Cell[BoxData[
 "Antihermitian"], "InlineCode",ExpressionUUID->
  "6ddfc457-477f-ff43-8988-630ccf90b7c4"],
 " are a special type of ",
 Cell[BoxData[
 "Complex"], "InlineCode",ExpressionUUID->
  "30c6dc95-387f-1c40-9c54-6c162a5a6af0"],
 " explained below on Subsection ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"sub hermitian"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub hermitian"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub hermitian"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub hermitian"],
  FontColor->RGBColor[0., 0., 1.]],
 ")."
}], "Item",
