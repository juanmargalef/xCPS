Cell[TextData[{
 "Since we always have the relations ",
 Cell[BoxData[
  RowBox[{"tensor", "\[RightArrow]", "dltensor"}]], "InlineCode",
  ExpressionUUID->"fe2a90fe-136a-7845-8442-a62c82d02071"],
 " and ",
 Cell[BoxData[
  RowBox[{"tensor", "\[RightArrow]", "VariationalVectortensor"}]], 
  "InlineCode",ExpressionUUID->"4aa92a39-8d7f-954b-8ffa-a96caa0e5036"],
 ", those relations are hidden by default from the graphs. This behaviour is \
controlled by the option ",
 Cell[BoxData[
  RowBox[{"HideVertExact", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"f2e6e226-5523-a64c-b039-250f01f302a2"],
 " and if set to ",
 Cell[BoxData[
 "False"], "InlineCode",ExpressionUUID->
  "4bd63bc8-5dbf-db4b-86c0-33033ecda53e"],
 ", all the nodes are shown."
}], "Text",
 CellChangeTimes->{{3.9501159200673237`*^9, 3.950115957213869*^9}, {
   3.955826196522402*^9, 3.9558262046237507`*^9}, {3.9572110977435684`*^9, 
