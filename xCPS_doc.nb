   3.9594897046381416`*^9}, {3.9595141307524147`*^9, 3.9595141474656982`*^9}, 
   3.9595726160361404`*^9},
 FontWeight->"Normal",
 FontColor->RGBColor[
  0., 0., 0.],ExpressionUUID->"38671150-8632-954b-ab92-2a71c436410e"]
}, Open  ]]
}, Closed]]
}, Open  ]],

