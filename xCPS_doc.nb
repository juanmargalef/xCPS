    RowBox[{"VariationalVector", "[", "tensor", "]"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"VertDeg", "[", "tensor", "]"}]}]}], " "}], "\[IndentingNewLine]", 
