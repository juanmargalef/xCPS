Cell[TextData[{
 "Sometimes we have already computed the ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "0c7f70c8-3e5e-c148-bd96-d6d8d45a4ba5"],
 " of a Lagrangian or we have performed a redefinition of fields (as we will \
see for electromagnetism in Chapter ",
 StyleBox[
 CounterBox["Chapter", "Chapter Electromag"],
  FontColor->RGBColor[0., 0., 1.]],
 ") and we need to use some of the previous functions (",
 Cell[BoxData[
 "FirstVariation"], "InlineCode",ExpressionUUID->
  "db4fcaf4-9470-6244-9a39-7e27e18a1c5a"],
 ", ",
 Cell[BoxData[
 "EOM"], "InlineCode",ExpressionUUID->"bf5778c1-2ef1-f649-a498-1b650d3bee99"],
 ", ",
 Cell[BoxData[
 "SymplecticPotential"], "InlineCode",ExpressionUUID->
  "a6b33e1d-3eb8-5a43-b7f5-19315d0ac9f8"],
 " and ",
 Cell[BoxData[
 "SymplecticCurrent"], "InlineCode",ExpressionUUID->
  "b15fcb56-5a76-b84c-b53e-6a2d0da32c65"],
 "). We have defined the analogous ones for ",
 Cell[BoxData[
 "dlLagrangianQ"], "InlineCode",ExpressionUUID->
  "c9d18ef6-3e68-7147-9eb7-b56e9d006d5b"],
 " (see Subsection",
 StyleBox[ButtonBox[" ",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox[
 CounterBox["Chapter", "Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub dl Lagragian and LagriangianQ"],
  FontColor->RGBColor[0., 0., 1.]],
 "). The arguments and options of these new functions are the same as the \
0-vertical-forms counterparts. In essence, they all satisfy the formula:"
}], "Text",
 CellChangeTimes->{{3.953402056161314*^9, 3.953402107645666*^9}, {
   3.9546624801787806`*^9, 3.9546624865750504`*^9}, {3.9560636286609263`*^9, 
