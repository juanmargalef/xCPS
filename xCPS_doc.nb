Cell[TextData[{
 "We will see later on ",
 StyleBox["Section ",
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox[
 CounterBox["Chapter", "Section Variational Vectors"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[".",
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Section Variational Vectors"],
  FontColor->RGBColor[0., 0., 1.]],
 " how to define variational vector fields (VVF). However, we can already \
mention that the values of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertInt", "[", "vvf", "]"}], "[", "VerticalForm", "]"}]], 
  "InlineCode",ExpressionUUID->"a8c6bcfa-bba4-234c-a13b-19821ce4016d"],
 " are what characterizes the VVFs and we will see later how to define them."
}], "Text",
