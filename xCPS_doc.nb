 CellTags->
  "Section Symplectic \
Potential",ExpressionUUID->"48410442-5543-d443-992a-3806b9c9f8cd"],

Cell[TextData[{
 "As we saw in Equation (",
 StyleBox[
 CounterBox["DisplayFormulaNumbered", "eq2: dlL=EOM+dTheta"],
  FontColor->RGBColor[0., 0., 1.]],
 "), when performing the Leibniz rule on ",
 Cell[BoxData[
  RowBox[{"\[DifferentialD]", "Lagrangian"}]], "InlineCode",ExpressionUUID->
  "ec931a1a-76ed-6940-b7ab-164c3f1dc3f2"],
 ", a total derivative term appears. The potential of that term is known as \
symplectic potential (which is only defined up to a total derivative)."
}], "Text",
 CellChangeTimes->{
  3.9560633193866034`*^9, {3.9582387421756287`*^9, 3.958238742358576*^9}, {
   3.958239407585869*^9, 3.9582394896911774`*^9}, {3.9595738385267067`*^9, 
   3.9595738439093266`*^9}},ExpressionUUID->"305610c3-a28a-f348-99d2-\
541af9789a0d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{"SymplecticPotential", "[", 
      RowBox[{"tensors", ",", " ", "der"}], "]"}], "[", "Lagrangian", "]"}], 
    " "}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"8c4391f7-29f0-6541-a0a9-d59f9acbe9dd"],
 "\nIt grabs the expression inside ",
 Cell[BoxData[
  RowBox[{"TotalDerivativeOf", "[", "der", "]"}]], "InlineCode",
  ExpressionUUID->"bf6b2f50-72ef-404a-8e75-6d307eb233dd"],
 " after performing ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"FirstVariation", "[", 
    RowBox[{"fields", ",", " ", "der"}], "]"}], "[", "Lagrangian", "]"}]], 
  "InlineCode",ExpressionUUID->"0826564b-c061-284b-aae3-fa3f1a7b14e8"],
 ".\n",
 StyleBox["\n",
  FontSize->3],
 "- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensors", "'"}]}]], "InlineCode",ExpressionUUID->
  "5b4bdcc2-e7de-c04e-8baa-906270819501"],
 ": optional argument to indicate the fields to be considered as dynamical. \
If not specified, all fields are considered dynamic.\n- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "639e462f-587f-504a-8f2a-e52c41b58527"],
 ": optional argument to specify the ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"7ba5fc77-3dcd-c149-9c7f-f83f2b41f220"],
 " to be used by ",
 Cell[BoxData[
 "FirstVariation"], "InlineCode",ExpressionUUID->
  "638c1e74-8224-504c-99ef-2ed6f00889e1"],
 "."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
