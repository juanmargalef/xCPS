   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "eb79fa92-680f-9448-897f-a8b0706010fd"],
 " has been modified to accept new types."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellDingbat->"\[FivePointedStar]",
 CellChangeTimes->{{3.9531120287768326`*^9, 3.953112046434929*^9}, {
   3.95466697492106*^9, 3.9546669797888985`*^9}, 3.955366599119338*^9, {
   3.958060624248308*^9, 3.958060624983383*^9}, {3.9580783796251926`*^9, 
   3.958078390182785*^9}},
 Background->GrayLevel[
