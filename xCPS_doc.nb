  RowBox[{
   RowBox[{"VertDeg", "[", "Tensor", "]"}], ">", "0"}]], "InlineCode",
  FontWeight->"Bold",ExpressionUUID->"3028789e-fd49-da4f-ab38-860bec91b16c"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", 
    RowBox[{
     SubscriptBox["\[ImaginaryI]", "vvf"], "tensor"}], "]"}], "=", 
