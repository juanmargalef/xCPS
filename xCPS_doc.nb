Cell[TextData[{
 "For vectors, we have ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"LieD", "[", "v", "]"}], "[", "v", "]"}], "=", "0"}]], 
  "InlineCode",ExpressionUUID->"7c7b1eab-39d4-ef44-ba89-911ffce2b484"],
 ", but for vertical forms, this is only true for Even-",
 Cell[BoxData[
 "VertDeg"], "InlineCode",ExpressionUUID->
  "d3977582-9b07-934a-9f3e-ef92b3c8d8b8"],
 " elements."
}], "Text",
