Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"TotalDerivativeQ", "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"3e4e319f-ab70-2e4a-b50e-03a5727bceac"],
 "\nIt returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"5101fd94-a3e4-c647-a8c3-c1df2d8a20f6"],
 " if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "4c521b9e-10c8-7c46-9ea8-fa4ae09c1f25"],
 " is a total derivative operator (with or without argument), and ",
 Cell[BoxData[
 "False"], "InlineCode",ExpressionUUID->
  "575fba5a-387d-aa4a-92d0-dd64e8765421"],
 " otherwise.\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"NormalOfCovDQ", "[", "n", "]"}], "[", "Manifold", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"999c601e-dd3f-6c41-8b88-bc750a881086"],
 "\nIt returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"07bd8fca-df15-4b44-8696-d454ceef4062"],
 " if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"n", "'"}]}]], "InlineCode",ExpressionUUID->
  "c9269896-a8ab-ec48-bcc7-a1bbad57cc0a"],
 " is a fiducial normal vector associated with a covariant derivative.\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"dlNormalOfCovDQ", "[", "dln", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"98c59941-dc5a-0941-931b-bdbdc4730ef6"],
 " \nIt returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"f37f667e-4f74-8f45-a5e1-8a8120646836"],
 " if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dln", "'"}]}]], "InlineCode",ExpressionUUID->
  "0bcab012-875a-274b-b6a5-29c77baaa1b4"],
 " is the vertical differential of a fiducial normal vector ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"n", "'"}]}]], "InlineCode",ExpressionUUID->
  "f339658b-ea8d-8143-8544-4ac8b24e0f9c"],
 "."
}], "Text",
