Cell[TextData[{
 "4. To prevent the expansion of the last term, we wrap it into a new linear ",
 Cell[BoxData[
 "InnertHead"], "InlineCode",ExpressionUUID->
  "847c7cab-095f-fa45-b2c5-5c9f857e4775"],
 " denoted"
}], "Text",
