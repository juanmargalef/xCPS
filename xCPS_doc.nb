Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VariationalRelationsOf", "[", 
    RowBox[{"tensor", ",", " ", "options"}], "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"ba88fb11-83d1-d846-8a26-8be4ae5693a5"],
 "\nIt extracts the subgraph of variational relations associated with ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "7de57913-e643-964d-be00-850d5927ffa3"],
 ".\n",
 StyleBox["\n",
  FontSize->5],
 "- Options:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ConstantTensors", "\[RightArrow]", 
   RowBox[{"ListContantTensors", ":"}]}]], "InlineCode",ExpressionUUID->
  "4ff4c0b6-7492-f044-bbb3-106be860f2b6"],
 " highlights the constant tensors of the graph associated with the initial ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"ListContantTensors", "'"}]}]], "InlineCode",ExpressionUUID->
  "ecbcb95d-d425-f74d-a770-02400152ba65"],
 ".\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"Directed", "\[RightArrow]", "direction"}]], "InlineCode",
  ExpressionUUID->"421366ea-ccc8-7f48-b887-03cc779a5a88"],
 ": shows the outward/inward/both vertices of the seed tensors (",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"direction", "'"}]}]], "InlineCode",ExpressionUUID->
  "8c7bc0f2-b8ed-4944-89a9-243370829241"],
 " can be ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"in", "'"}]}]], "InlineCode",ExpressionUUID->
  "1b3da544-4330-b144-8eca-1eefbfff9b70"],
 ", ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"out", "'"}]}]], "InlineCode",ExpressionUUID->
  "4118987f-3bc2-864a-b093-2739f998a2ab"],
 " or ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"both", "'"}]}]], "InlineCode",ExpressionUUID->
  "ef135319-0051-614a-a3d5-20d9d023ca5f"],
 ").\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"HideTrivialRelations", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"8a907973-e9de-1845-b1fb-8834ba47c3a2"],
 ": controls whether trivial variational relations between tensors and their ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "e68e59c4-a788-c749-9bf6-8b2ef803fa22"],
 " and ",
 Cell[BoxData[
 "VariationalVector"], "InlineCode",ExpressionUUID->
  "9eeda807-906d-0e4b-b78d-c40feef4de07"],
 " are shown."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
