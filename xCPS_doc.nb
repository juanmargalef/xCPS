 StyleBox["Warning: ",
  FontWeight->"Bold"],
 Cell[BoxData[
 "AddVariationalRelation"], "InlineCode",ExpressionUUID->
  "f8501f8f-f8b1-a24e-b469-d56855bf9e94"],
 " and ",
