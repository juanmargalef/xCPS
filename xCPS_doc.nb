Cell[TextData[{
 "To check the formula for the volume form, we need to fix the dimension \
(otherwise ",
 StyleBox["xAct",
  FontWeight->"Bold"],
 " defines ",
 Cell[BoxData[
  RowBox[{"epsilon", "[", "metric", "]"}]], "InlineCode",ExpressionUUID->
  "7e95addc-ad15-744e-947e-aabbb4fd8d17"],
 " with only two indices). Thus, we define a new 4-dimensional manifold with \
two metrics on it. "
}], "Text",
 CellChangeTimes->{{3.9487553437378225`*^9, 3.948755361515424*^9}, {
   3.948814150639663*^9, 3.948814150885988*^9}, {3.951859271316168*^9, 
