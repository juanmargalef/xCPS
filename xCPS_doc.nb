Cell[TextData[{
 "As we mention on Subsection ",
 StyleBox[
 CounterBox["Chapter", "Sub symplectic Potential"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub symplectic Potential"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub symplectic Potential"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub symplectic Potential"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub symplectic Potential"],
  FontColor->RGBColor[0., 0., 1.]],
 " of the introduction, given a Lagrangian ",
 Cell[BoxData[
  RowBox[{"L", 
   RowBox[{"(", 
    SuperscriptBox["\[Phi]", "i"], ")"}]}]], "InlineCode",ExpressionUUID->
  "649b6037-86e2-ca44-b049-4fc32a2da3ec"],
 ", if we take its ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "9d8c9f4a-b96d-fc42-98f4-d7fe8827c989"],
 " and perform the Leibniz rule, we can always decompose the expression as \
follows:"
}], "Text",
 CellChangeTimes->{{3.953223282362236*^9, 3.9532233929486465`*^9}, {
   3.953223537162197*^9, 3.953223542612646*^9}, {3.9532258739661465`*^9, 
   3.953225893111204*^9}, {3.9532302700400276`*^9, 3.953230313001465*^9}, 
   3.957079623669981*^9, {3.957830731593277*^9, 3.957830746506708*^9}, 
   3.957889384350541*^9, {3.957889450435377*^9, 3.957889452288784*^9}, {
   3.9578895183473444`*^9, 3.957889556338175*^9}, {3.9579583101041822`*^9, 
   3.9579583111863327`*^9}, {3.95795838850933*^9, 3.9579584346682625`*^9}, {
   3.9580508013403835`*^9, 3.9580508224279404`*^9}, {3.9582350316523933`*^9, 
   3.958235076135563*^9}, {3.9586092946740627`*^9, 3.9586092954725623`*^9}, {
   3.9586129240870047`*^9, 3.9586129240925703`*^9}, 3.958640719143507*^9, 
   3.9595787484057465`*^9, 3.959578854472868*^9, {3.960299301070923*^9, 
   3.960299308591831*^9}},ExpressionUUID->"f73e51c0-8b32-bf4e-b3af-\
06fff75b9c94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[DifferentialD]", "L"}], "=", 
  RowBox[{
   RowBox[{
    SubscriptBox["EOM", "i"], 
    RowBox[{"\[DifferentialD]", 
     SuperscriptBox["\[Phi]", "i"]}]}], "+", 
   "d\[CapitalTheta]"}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.950558777787306*^9, 3.950558913121212*^9}, {
   3.950965093094467*^9, 3.9509651190081415`*^9}, 3.950965161268156*^9, 
   3.950965291073814*^9, {3.9639570478797665`*^9, 3.963957048389105*^9}, 
   3.9845047744200344`*^9},
 TextAlignment->Center,
 CellTags->
  "eq2: dlL=EOM+dTheta",ExpressionUUID->"65e16646-37d4-1442-9f44-\
230035b55722"],

Cell[TextData[{
 "where:\n\[Bullet] ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox["EOM", "i"],
   FontWeight->"Bold"]],
  CellChangeTimes->{{3.950558777787306*^9, 3.950558913121212*^9}, {
   3.950965093094467*^9, 3.95096512287224*^9}, {3.950965435496889*^9, 
   3.950965469681305*^9}, {3.950978792297262*^9, 3.950978828737831*^9}, {
   3.95178934857366*^9, 3.951789390661476*^9}, {3.9523430217973757`*^9, 
   3.9523430542658587`*^9}, {3.9523430944954386`*^9, 3.9523431673285823`*^9}},
  ExpressionUUID->"4a85ef26-51c7-f64d-82d6-3f1a622befd1"],
 ", sometimes denoted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{"\[Delta] ", "\[NegativeThinSpace]", 
          StyleBox["L", "TI"]}], 
        SuperscriptBox["\[Delta]\[Phi]", 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\delta\\,\\!L}{\\delta\\phi^i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb651fa6-3632-ea43-b185-66a7b05c6fc6"],
 " in the physics literature, are the Equations of Motion with respect to the \
field ",
 Cell[BoxData[
  SuperscriptBox["\[Phi]", "i"]],
  CellChangeTimes->{{3.950558777787306*^9, 3.950558913121212*^9}, {
   3.950965093094467*^9, 3.95096512287224*^9}, {3.950965435496889*^9, 
   3.950965469681305*^9}, {3.950978792297262*^9, 3.950978828737831*^9}, {
   3.95178934857366*^9, 3.951789390661476*^9}, {3.9523430217973757`*^9, 
   3.9523430542658587`*^9}, {3.9523430944954386`*^9, 3.9523431673285823`*^9}},
  ExpressionUUID->"bd66e5f2-322e-ef4b-888e-12e27f16ac81"],
 ".\n\[Bullet] ",
 StyleBox["\[CapitalTheta] ",
  FontWeight->"Bold"],
 "is the ",
 StyleBox["symplectic potential",
  FontSlant->"Italic"],
 " of the Lagrangian.\n\nThis is precisely the role of ",
 Cell[BoxData[
 "FirstVariation"], "InlineCode",ExpressionUUID->
  "48991262-20f2-7c43-abed-9dfc6f315bec"],
 "."
}], "Text",
 CellChangeTimes->{{3.9524375720261602`*^9, 3.9524377038186483`*^9}, {
   3.957443332002407*^9, 3.9574433329683285`*^9}, {3.957600689033552*^9, 
   3.9576006906280165`*^9}, {3.957820482810581*^9, 3.9578205386269608`*^9}, 
   3.957883100577282*^9, 3.957883451377553*^9, 3.9580408961654797`*^9, {
   3.9580508337891083`*^9, 3.9580508501867676`*^9}, {3.9582350578989964`*^9, 
   3.9582350580534687`*^9}, {3.9595767872792263`*^9, 
   3.9595767893995686`*^9}},ExpressionUUID->"31618eda-50e7-634d-801b-\
fc81578ba336"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"FirstVariation", "[", 
     RowBox[{"tensors", ",", " ", "der", ",", " ", "options"}], "]"}], "[", 
    "Lagrangian", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"1de8672c-8df9-2d48-a0dc-b4eaa80d29cb"],
 "\nIt computes the first variation of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Lagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "047599b5-3231-8d44-a85a-7b0234cb93da"],
 " keeping the total derivative term.\n",
 StyleBox["\n",
  FontSize->3],
 "- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"fields", "'"}]}]], "InlineCode",ExpressionUUID->
  "fa0ba509-7040-4a4c-9e9d-1f9bd99a3172"],
 ": optional argument to indicate the fields to be considered as dynamical. \
If not specified, all fields are considered dynamic.\n- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "d2a833bf-6707-ec43-bf70-4098f5ff7457"],
 ": optional argument to specify the ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"69cf7704-fd3f-0249-8b0a-4ce48cafd5f8"],
 " to be used by ",
 Cell[BoxData[
 "FirstVariation"], "InlineCode",ExpressionUUID->
  "91259264-7811-8545-9026-32ca5a026d6a"],
 ".\n- Options:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"Simplification", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"743f5a21-f695-db44-9b25-63069305578a"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ContractMetric", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"8d48aebc-7ff5-f549-9c86-bb9843fdd96e"],
 "."
}], "Text",
