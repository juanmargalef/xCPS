Cell[TextData[{
 "This is so because \[Phi] is assumed to be independent of its derivatives \
(this is consistent with the \[Infinity]-jet bundle formalism, see [",
 StyleBox[
 CounterBox["ItemNumbered", "bibliography CPS JMB-EJSV"],
  FontColor->RGBColor[1., 0.2901960784313726, 0.2901960784313726]],
 ",",
 StyleBox[
 CounterBox["ItemNumbered", "bibliography Anderson"],
  FontColor->RGBColor[1., 0.2901960784313726, 0.2901960784313726]],
 "])."
}], "Text",
