    SubscriptBox["dltensor", "i"], "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"VertDeg", "[", 
     SubscriptBox["tensor", "i"], "]"}]}]}]], "InlineCode",ExpressionUUID->
  "4f7d1383-e3f1-a647-ad21-f89c41143772"],
