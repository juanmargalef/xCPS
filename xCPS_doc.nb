Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", 
    RowBox[{"VariationalVector", "[", "tensor", "]"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"VertDeg", "[", "tensor", "]"}]}]}]], "InlineCode",ExpressionUUID->
  "684004ae-33d1-a844-bd59-634f10e68a44"],
 ", we have that ",
 Cell[BoxData[
 "VertDeg"], "InlineCode",ExpressionUUID->
  "67ca0de7-3403-bd45-a808-b6bb2954a650"],
 " of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VVFFromLieD", "[", "vector", "]"}], "[", "components", "]"}]], 
  "InlineCode",ExpressionUUID->"c984f900-88fa-b445-88da-df1ed03c5461"],
 " is always well defined (and equal to ",
 Cell[BoxData[
  RowBox[{"VertDeg", "[", "vector", "]"}]], "InlineCode",ExpressionUUID->
  "3bd7b9d4-3041-5240-ac03-205a02068fda"],
 "):"
}], "Text",
