Cell[TextData[{
 StyleBox["Important:",
  FontWeight->"Bold"],
 StyleBox[" If we \[OpenCurlyDoubleQuote]evaluate\[CloseCurlyDoubleQuote] the \
indices first and then take the ",
  FontWeight->"Plain"],
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "af8849a2-d89d-2043-9c0e-a27387e8025d"],
 StyleBox[", the Riemann is transformed by ",
  FontWeight->"Plain"],
 StyleBox["xAct",
  FontWeight->"Bold"],
 StyleBox[" into the Ricci before ",
  FontWeight->"Plain"],
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "9ee4e936-2883-e04c-86ca-3d18fbfd5377"],
 StyleBox[" acts as the following computation shows:",
  FontWeight->"Plain"]
}], "Item",
 CellChangeTimes->{
  3.9576107520129833`*^9, {3.9577868916370983`*^9, 3.9577868940430784`*^9}, {
   3.958040960033188*^9, 3.958040962208946*^9}, {3.9580651923392982`*^9, 
   3.9580651932995415`*^9}, {3.959573346626133*^9, 3.9595733471500225`*^9}, {
   3.9595746597510757`*^9, 3.9595746769041977`*^9}},
 FontWeight->"Normal",
 FontColor->RGBColor[
  0., 0., 0.],ExpressionUUID->"ca1c0f70-6711-9b4f-a692-f0c583b2aebc"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   SuperscriptBox[
    SubscriptBox[
     RowBox[{"(", "dlRiemann", ")"}], "abc"], "b"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Delta]", "d"], "b"], 
     SuperscriptBox[
      SubscriptBox[
       RowBox[{"(", "dlRiemann", ")"}], "abc"], "d"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Delta]", "d"], "b"], 
      RowBox[{"VertDiff", "[", 
       SuperscriptBox[
        SubscriptBox["Riemann", "abc"], "d"], "]"}]}], 
     OverscriptBox["=", "\[Diamond]"], 
     RowBox[{
      RowBox[{"VertDiff", "[", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Delta]", "d"], "b"], 
        SuperscriptBox[
         SubscriptBox["Riemann", "abc"], "d"]}], "]"}], "=", 
      RowBox[{
       RowBox[{"VertDiff", "[", 
        SuperscriptBox[
         SubscriptBox["Riemann", "abc"], "b"], "]"}], "=", 
       RowBox[{"VertDiff", "[", 
        SubscriptBox["Ricci", "ac"], "]"}], 
       " "}]}]}]}]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{
  3.9524352325735483`*^9, {3.952435361228217*^9, 3.952435361228217*^9}, {
   3.952435409851966*^9, 3.9524354187236357`*^9}, {3.95813506517976*^9, 
