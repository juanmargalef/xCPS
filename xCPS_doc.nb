Cell[TextData[{
 "As we can see in the following examples, ",
 Cell[BoxData[
  StyleBox["VertDiff",
   FontColor->RGBColor[0.25098039215686274`, 0., 0.25098039215686274`]]], 
  "InlineCode",
  FontColor->RGBColor[
   0.5019607843137255, 0.5019607843137255, 0.5019607843137255],ExpressionUUID->
  "f8780658-8cd3-4e4c-82f3-86614bc5d72f"],
 " function can be used without indices, with indices outside or with indices \
inside. When metrics are present, one should be careful since they might not \
be equivalent (see Subsubsection ",
 StyleBox[
 CounterBox["Chapter", 
  "Subsub Raising and Lowering indices do not commute with VertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
