 "Simplification"], "InlineCode",ExpressionUUID->
  "53a58157-7149-df4b-a8d0-f56b4f2c449a"],
 " or ",
 Cell[BoxData[
 "ContractMetric"], "InlineCode",ExpressionUUID->
