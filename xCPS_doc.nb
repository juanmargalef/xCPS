Cell[TextData[{
 "which describes the infinitesimal transformation:",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"\[Phi]", "->", 
    RowBox[{"\[Phi]", "+", 
     RowBox[{
      SubscriptBox["\[Epsilon]\[ScriptCapitalL]", "\[Xi]"], "\[Phi]"}]}]}]}]],
  ExpressionUUID->"26a71e64-81db-3d4e-a500-30575ae11989"],
 " and ",
 Cell[BoxData[
  RowBox[{"g", "->", 
   RowBox[{"g", "+", 
    RowBox[{
     SubscriptBox["\[Epsilon]\[ScriptCapitalL]", "\[Xi]"], "g"}]}]}]],
  ExpressionUUID->"fe710c43-3e81-5f45-9648-afdcbe974625"],
 ". This means that ",
 StyleBox["all",
  FontWeight->"Bold"],
 " fields are transformed using the Lie derivative (no background objects are \
present, see [",
 StyleBox[
 CounterBox["ItemNumbered", "bibliography CPS JMB-EJSV"],
  FontColor->RGBColor[1., 0.2901960784313726, 0.2901960784313726]],
 "]). In fact, whenever ",
 Cell[BoxData[
 "VVF"], "InlineCode",ExpressionUUID->"e56f0970-e692-d645-81bc-e3f20d0aad8d"],
 " is a ",
 Cell[BoxData[
  RowBox[{"VVFFromLieD", "[", "xi", "]"}]], "InlineCode",ExpressionUUID->
  "d51fcd2f-487b-4d42-973a-0d037129339f"],
 ", we always have "
}], "Text",
 CellChangeTimes->{{3.950890985558349*^9, 3.950891036705971*^9}, {
   3.950891068130377*^9, 3.950891115738426*^9}, {3.95089122726511*^9, 
   3.950891365153498*^9}, {3.950891433390114*^9, 3.950891434360166*^9}, {
   3.950891512424155*^9, 3.95089152052244*^9}, {3.9509790738750134`*^9, 
   3.9509790744247723`*^9}, {3.950979116644966*^9, 3.950979217711254*^9}, 
