Cell[TextData[{
 "The notion of generic ",
 Cell[BoxData[
 "VBundles"], "InlineCode",ExpressionUUID->
  "252c6580-842a-0743-945d-e561199ef6d7"],
 " was introduced after ",
 StyleBox["xPert",
  FontWeight->"Bold"],
 " was released and it has not been updated. Thus, ",
 Cell[BoxData[
 "ExpandPerturbation"], "InlineCode",ExpressionUUID->
  "626f2d65-5177-0c4a-84bb-dbb0762f8d6d"],
 " does not include these expansions. As before, the interested reader can \
find the verification of the formulas used by ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "b65b79d1-c709-d64c-abd4-089bdde5ac40"],
 " in Section ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 " ",
 StyleBox["of the Appendix",
  FontWeight->"Normal",
  FontColor->RGBColor[0., 0., 0.]],
 "."
}], "Text",
