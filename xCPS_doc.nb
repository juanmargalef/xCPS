Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"TotalDerivativeDivergenceQ", "[", "expr", "]"}], " "}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"b49a1e5e-5329-8340-9ffd-674cad896544"],
 "\nIt returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"2e80ece7-45a8-0547-b79f-6abfdb7d1bd6"],
 " if ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "0aa3fe0d-80a6-8e40-a49d-d9523ed09433"],
 " if it is a scalar of weight 1 with a ",
 Cell[BoxData[
  RowBox[{"NormalOfCovD", "[", "der", "]"}]], "InlineCode",ExpressionUUID->
  "f7e59e4a-8b7d-2541-8eef-7d66c034a825"],
 " covector, all wrapped with a ",
 Cell[BoxData[
  RowBox[{"TotalDerivativeOfCovD", "[", "der", "]"}]], "InlineCode",
  ExpressionUUID->"2bf480b3-6cc0-f043-bdde-2de073dac849"],
 " head. It returns ",
 Cell[BoxData[
 "False"], "InlineCode",ExpressionUUID->
  "cd066519-e09d-7f4d-8d87-72adee79f73f"],
 " otherwise."
}], "Text",
