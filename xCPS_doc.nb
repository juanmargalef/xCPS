 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"EOM", "[", 
     RowBox[{"field", ",", " ", "der"}], "]"}], "[", "Lagrangian", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",
  FontColor->RGBColor[0., 0., 0.],ExpressionUUID->
  "12446a44-3f4f-3142-84dc-f939b893b5d8"],
 StyleBox["\n",
  FontSize->3],
 "It returns the Equations of Motion of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Lagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "12ecea1b-b7c8-c246-a1bb-6521d147fc8a"],
 " with respect to ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"field", "'"}]}]], "InlineCode",ExpressionUUID->
  "13c1a8ab-c855-d243-9fba-f1c98e97fbe8"],
 ". The argument ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "e792cafc-af6b-f842-89dd-703b7204c5de"],
 " is optional. If not specified, it finds the only ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"54fbda4c-46cb-7f42-8b31-c317a3eec69a"],
 " present (if several are present, an error is thrown)."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
