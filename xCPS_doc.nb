Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"FirstVariation", "[", "tensors", "]"}], "[", "Lagrangian", "]"}]],
   "InlineCode",ExpressionUUID->"2fa41016-9392-6341-bff3-8e2f6ef6ffd3"],
 " computes the First Variation of ",
 Cell[BoxData[
 "Lagrangian"], "InlineCode",ExpressionUUID->
  "d046aeb6-417e-1542-98b2-75ac83a9ecae"],
 " following the steps:\n1. Take ",
 Cell[BoxData[
  RowBox[{"VertDiff", "[", "Lagrangian", "]"}]], "InlineCode",ExpressionUUID->
  "1c12f818-daec-0e4b-ab3b-40d939ac51af"],
 " followed by ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiff", "[", 
   RowBox[{"NonConstantTensors", "\[RightArrow]", "tensors"}], "]"}]], 
  "InlineCode",ExpressionUUID->"f831b655-ace6-ef4b-9c14-eadc04e636a0"],
 " which, schematically, will be of the form"
}], "Text",
 CellChangeTimes->{{3.953223282362236*^9, 3.9532233929486465`*^9}, {
   3.953223537162197*^9, 3.953223542612646*^9}, {3.9532258739661465`*^9, 
   3.953225893111204*^9}, {3.9532303161598434`*^9, 3.953230327792284*^9}, {
