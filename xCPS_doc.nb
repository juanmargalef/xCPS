Cell[TextData[{
 "We can in fact prove that ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf1", "'"}]}]], "InlineCode",ExpressionUUID->
  "9b5bc05f-5561-ed43-8e4d-80f898389885"],
 " is not only a symmetry, but it is also a gauge transformation i.e., a \
transformation that, when restricted to the space of solutions (on-shell) has \
",
 Cell[BoxData[
  RowBox[{"Hamiltonian", "=", "0"}]], "InlineCode",ExpressionUUID->
  "9b77329c-5898-c044-b0db-1b8634adeda3"],
 ":"
}], "Text",
