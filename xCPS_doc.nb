Cell[TextData[{
 "Since ",
 Cell[BoxData[
 "VertLie"], "InlineCode",ExpressionUUID->
  "0cb14234-58f2-6649-9b55-750fdf99777e"],
 " plays no role in the previous computations (it does not appear before the \
rule is applied), we can omit it. In that case, ",
 Cell[BoxData[
 "SortVertOperators"], "InlineCode",ExpressionUUID->
  "e6e9d07b-ef57-5b46-8780-2d88324c0e20"],
 " assumes ",
 Cell[BoxData[
 "VertLie"], "InlineCode",ExpressionUUID->
  "8a282478-6871-1442-92d5-8dae96ecb659"],
 " is in last position."
}], "Text",
 CellChangeTimes->{{3.9563790654286633`*^9, 3.956379082705743*^9}, 
   3.95805360569479*^9, {3.9580833776672306`*^9, 3.9580833853002167`*^9}, {
