17623c0d2dc6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GenerateExpandVertDiffRule", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"dlbeta", "[", 
     RowBox[{"a", ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"dlv1", "[", "a", "]"}], "\:2a55", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"alpha3", "[", 
        RowBox[{"-", "b"}], "]"}], 
       RowBox[{"alpha0", "[", 
        RowBox[{"-", "c"}], "]"}], 
       RowBox[{"v0", "[", "c", "]"}]}], ")"}]}]}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dlbeta", "[", 
   RowBox[{"a", ",", 
    RowBox[{"-", "b"}]}], "]"}], "==", 
  RowBox[{"(", 
   RowBox[{
