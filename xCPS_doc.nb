Cell[TextData[{
 "We need to apply Bianchi's identity. We could use ",
 StyleBox["TInvar",
  FontWeight->"Bold"],
 " or ",
 StyleBox["xTras",
  FontWeight->"Bold"],
 ", but to make this notebook self-contained, we use ",
 "the following code (based on ",
 ButtonBox["Teake's code",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://groups.google.com/g/xact/c/0ZJHUmFj7WI/m/HZ-4hsdkddMJ"], 
    None},
  ButtonNote->"https://groups.google.com/g/xact/c/0ZJHUmFj7WI/m/HZ-4hsdkddMJ"],
 ")."
}], "Text",
 CellChangeTimes->{{3.957597492801111*^9, 3.9575975010237722`*^9}, {
  3.958248737629963*^9, 3.958248772852585*^9}, {3.9582489789458046`*^9, 
  3.9582489789587975`*^9}, {3.9582490523405*^9, 3.958249052352495*^9}, {
  3.9582522119286213`*^9, 
  3.958252212196409*^9}},ExpressionUUID->"37bbdbcb-5775-4242-b5fb-\
b40e5ac4d1b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"BianchiRule1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Ordering", "[", 
        RowBox[{"{", 
         RowBox[{"b", ",", "c", ",", "d"}], "}"}], "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], ")"}]}], "->", 
    RowBox[{
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "-", 
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a", ",", "d", ",", "b", ",", "c"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BianchiRule2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LCDer", "[", "a_", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"b_", ",", "c_", ",", "d__"}], "]"}]}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Ordering", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], ")"}]}], "->", 
    RowBox[{
     RowBox[{
      RowBox[{"LCDer", "[", "b", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"LCDer", "[", "c", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"a", ",", "b", ",", "d"}], "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BianchiContracted1", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"LCDer", "[", 
         RowBox[{"-", "e"}], "]"}], "@", 
        RowBox[{"RiemannLCDer", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "c"}], ",", 
          RowBox[{"-", "d"}], ",", "e"}], "]"}]}], ",", 
       RowBox[{"$RicciSign", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "c"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "a"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "c"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BianchiContracted2", "=", 
    RowBox[{"MakeRule", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LCDer", "[", 
          RowBox[{"-", "b"}], "]"}], "@", 
         RowBox[{"RicciScalarLCDer", "[", "]"}]}], ",", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"LCDer", "[", 
           RowBox[{"-", "a"}], "]"}], "[", 
          RowBox[{"RicciLCDer", "[", 
           RowBox[{"a", ",", 
            RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ApplyBianchi", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ToCanonical", "[", "expr", "]"}], "//.", "BianchiRule1"}], "//.",
        "BianchiRule2"}], "//.", "BianchiContracted1"}], "//.", 
     "BianchiContracted2"}], "//", "ToCanonical"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"NoetherSymmetryQ", "[", "vvfGR", "]"}], "[", "g", "]"}], "[", 
     "LGR", "]"}], "//", "ApplyBianchi"}], "//", "ContractMetric"}], "//", 
  "Simplification"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"NoetherSymmetryQ", "[", "vvfGR", "]"}], "[", "g", "]"}], "[", 
      "LGR", "]"}], "//", "SortCovDs"}], "//", "ApplyBianchi"}], "//", 
   "ContractMetric"}], "//", "Simplification"}]}], "Input",
 CellChangeTimes->{{3.955468462204777*^9, 3.9554684979068584`*^9}, {
  3.955468664251276*^9, 3.955468703900099*^9}, {3.955827278527565*^9, 
