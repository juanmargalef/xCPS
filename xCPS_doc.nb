Cell[TextData[{
 "This function is similar to ",
 Cell[BoxData[
 "ExpandPerturbation"], "InlineCode",ExpressionUUID->
  "28c124ce-1cf2-794e-b487-2b54768aa782"],
 " from ",
 StyleBox["xPert",
  FontWeight->"Bold"],
 " with some additional functionalities. It expands the vertical derivative \
of some expression in terms of others. ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 " allows the user to create new expanding rules and it also includes several \
predefined rules."
}], "Text",
 CellChangeTimes->{{3.9559497167488384`*^9, 3.9559497253876066`*^9}, 
   3.957077075784397*^9, 3.957507448379019*^9, {3.958083509082983*^9, 
