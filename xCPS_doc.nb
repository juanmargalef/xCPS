Cell[TextData[{
 "One important comment is that when a non-frozen metric is involved in the \
definition of a ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "610d524d-4bd1-c54d-b815-263561baaa28"],
 ", two of them are actually defined: using the metric and its inverse."
}], "Text",
 CellChangeTimes->{{3.9564266199146748`*^9, 3.956426662765444*^9}, 
   3.956671713080917*^9, {3.9566719109464526`*^9, 
   3.9566719210046463`*^9}},ExpressionUUID->"521db260-7462-6c43-be45-\
8ea873b0f473"],

