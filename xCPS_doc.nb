Cell[BoxData[{
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"InvG2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", "\"\<\[NotEqual]\>\"", ",", 
   RowBox[{"G2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", "\"\<=\>\"", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"G2", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "//", 
     RowBox[{"SeparateMetric", "[", "]"}]}], "//", "ScreenDollarIndices"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VertDiff", "[", 
   RowBox[{"InvG2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], "]"}], "==", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"VertDiff", "[", 
     RowBox[{"InvG2", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "]"}], "//", 
    RowBox[{"ExpandVertDiff", "[", "]"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"VertDiff", "[", 
    RowBox[{"InvG2", "[", 
     RowBox[{"a", ",", "b"}], "]"}], "]"}], ",", "\"\<\[NotEqual]\>\"", ",", 
   RowBox[{
    RowBox[{"dlG2", "[", 
     RowBox[{"a", ",", "b"}], "]"}], "==", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"dlG2", "[", 
        RowBox[{"a", ",", "b"}], "]"}], "//", 
       RowBox[{"SeparateMetric", "[", "]"}]}], "//", "ScreenDollarIndices"}], 
     ")"}]}]}], "]"}]}], "Input",
