Cell[TextData[{
 "This transformation between tensors with ",
 Cell[BoxData[
 "Invg"], "InlineCode",ExpressionUUID->"e359511a-b78a-e443-a07d-10dc4771bbd6"],
 " into tensors with ",
 Cell[BoxData[
 "g"], "InlineCode",ExpressionUUID->"d50a1ca0-5a0f-9d44-a4f1-a908b2ebe121"],
 " is controlled by the constant."
}], "Text",
 CellChangeTimes->{{3.956426925644573*^9, 3.9564269815246563`*^9}, {
   3.95642707503228*^9, 3.95642711444368*^9}, 3.9566717268270903`*^9, {
   3.9566718580557823`*^9, 3.956671861680359*^9}, {3.9582216286577854`*^9, 
   3.9582216439774036`*^9}, {3.9582217115799274`*^9, 
   3.958221719542017*^9}},ExpressionUUID->"9cfe54a8-94d3-ae48-9c37-\
13c13fc93ad7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["$UseInverseMetric",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"b9c4b213-b632-674c-817c-eba9b7953b92"],
 "\nIt is a boolean flag indicating whether the inverse metric is used as the \
fundamental field instead of the metric. This constant should be fixed at the \
beginning and posterior changes might produce unexpected results."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437867524809*^9, 3.9524378774013205`*^9}, {
   3.953087305389626*^9, 3.9530873445165377`*^9}, 3.954480967702871*^9, {
