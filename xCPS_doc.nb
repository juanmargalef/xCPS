Cell[TextData[{
 "These formulas are analogous to the formulas implemented for ",
 Cell[BoxData[
 "ExpandPerturbation"], "InlineCode",ExpressionUUID->
  "1719fdb5-6396-a04b-9607-c985ac6acd4c"],
 " in ",
 StyleBox["xPert",
  FontWeight->"Bold"],
 ". Notice, however, that ",
 StyleBox["xPert ",
  FontWeight->"Bold"],
 "was not coded to handle frozen metric so it provides incorrect formulas. As \
before, the interested reader can find the verification of the formulas used \
by ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "2ce3b158-cf9f-2343-a510-3c3dacef0805"],
 " in Section ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 " ",
 StyleBox["of the Appendix",
  FontWeight->"Normal",
  FontColor->RGBColor[0., 0., 0.]],
 "."
}], "Text",
 CellChangeTimes->{{3.950273393056343*^9, 3.950273484157284*^9}, {
