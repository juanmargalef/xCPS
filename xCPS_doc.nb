Cell[TextData[{
 "When ",
 Cell[BoxData[
 "Imaginay"], "InlineCode",ExpressionUUID->
  "d396cf6f-9584-4a4c-8be4-47ca29dc81da"],
 " objects are involved, things are a bit trickier since for each one of \
them, a minus sign appears when conjugating. Thus, the overall sign depends \
on the parity (counting tensors + the function):"
}], "Text",
