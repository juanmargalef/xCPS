Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"GenerateExpandVertDiffRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dltensor", ",", " ", "expansion"}], "}"}], ",", " ", 
     "options"}], "]"}],
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",
  FontWeight->"Bold",ExpressionUUID->"eb2cc887-2c45-8649-b534-d3656e472101"],
 StyleBox[" \n",
  FontWeight->"Bold"],
 "It generates the expansion rule ",
