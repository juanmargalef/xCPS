Cell[TextData[{
 "As we have mentioned before, the variational relations form a graph so we \
can use all the Mathematica commands for graphs. ",
 Cell[BoxData[
  RowBox[{"VariationalRelationsOf", "[", "tensor", "]"}]], "InlineCode",
  ExpressionUUID->"4c52b467-ae1c-a34e-b501-e4410dda8565"],
 " shows the graph of dependency of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "a8ae3590-43eb-a843-bbb8-20ad266aca02"],
 ". ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "7136f7b5-7b07-ac40-96e5-779ce12e76f5"],
 " is represented as a green triangle and the rest of tensors as blue circles."
}], "Text",
 CellChangeTimes->{{3.9501158583789577`*^9, 3.9501159104804573`*^9}, {
   3.9501164912093277`*^9, 3.9501165058441544`*^9}, {3.9501173891294785`*^9, 
