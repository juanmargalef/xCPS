Cell[TextData[{
 "One of the most powerful features of ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 " is that it can can handle generic Lagrangians that depend on some tensors. \
For instance, we can consider a Lagrangian that depends on a scalar field. \
Based on what we explained on Subsection ",
 StyleBox[
 CounterBox["Chapter", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub scalar functions and ExpandVertDiff"],
  FontColor->RGBColor[0., 0., 1.]],
 ", one might naively think that it should be enough to define"
}], "Text",
 CellChangeTimes->{{3.9554682754628124`*^9, 3.9554683427706566`*^9}, {
