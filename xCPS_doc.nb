Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"LagrangianQ", "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"ac5a5aae-3071-7c40-96a5-3a9d36183a17"],
 "\nIt verifies whether ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "1b9c8057-2005-4544-94b6-3b41b17bdc80"],
 " is a scalar with zero vertical degree.\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"dlLagrangianQ", "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"79e33310-e178-a446-ac02-03430c9b3fa1"],
 "\nIt verifies whether ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "ab9a9440-f769-284c-b83a-b5c2c95d8310"],
 " is a scalar with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", "expr", "]"}], "=", "1"}]], "InlineCode",
  ExpressionUUID->"707ba5ab-cd2b-6848-812c-f44e6efacb2d"],
 " and one exact vertical form per monomial."
}], "Text",
