Cell["\<\
This function lists the tensors (nodes) that are connected to a given tensor. \
For generic tensors we have:\
\>", "Text",
 CellChangeTimes->{{3.9501146582114077`*^9, 3.9501148036618843`*^9}, {
   3.95011485672637*^9, 3.9501150853789864`*^9}, {3.9501156828299046`*^9, 
   3.9501157362206345`*^9}, {3.9514792115025673`*^9, 3.9514792184243374`*^9}, 
   3.951869246445036*^9, {3.9565207100389423`*^9, 3.9565209203303833`*^9}, 
   3.957585684172675*^9, {3.958156838450508*^9, 
   3.9581568859371395`*^9}},ExpressionUUID->"5eb5e6dd-3069-774c-9a09-\
7088ef19bf72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "general", " ", "tensor", " ", "only", " ", "depends", " ", "on",
     " ", "itself"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListVariationalRelationsOf", "[", 
    RowBox[{"v2", ",", 
     RowBox[{"Directed", "->", "In"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "A", " ", "general", " ", "tensor", " ", "affects", " ", "its", " ", 
     "VertDiff", " ", "and", " ", "VariationalVector"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", 
    RowBox[{"v2", ",", 
     RowBox[{"Directed", "->", "Out"}]}], "]"}], " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "can", " ", "take", " ", "the", " ", "union", " ", "of", " ", 
     "the", " ", "previous", " ", "ones"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", 
    RowBox[{"v2", ",", 
     RowBox[{"Directed", "->", "Both"}]}], "]"}], " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "That", " ", "is", " ", "actually", " ", "the", " ", "default", " ", 
     "behaviour"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", "v2", "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", 
    RowBox[{"dlv2", ",", 
     RowBox[{"Directed", "->", "In"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", 
    RowBox[{"dlv2", ",", 
     RowBox[{"Directed", "->", "Out"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"ListVariationalRelationsOf", "[", "dlv2", "]"}]}]}]], "Input",
