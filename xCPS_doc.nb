Cell[TextData[{
 "We see that the symmetry potentials do not agree. However, they are equal \
up to a divergence/exact term, as expected for any potential (see Subsection ",
 StyleBox[
 CounterBox["Chapter", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 " for an explanation of ",
 Cell[BoxData[
 "NormalOfCovDToCovD"], "InlineCode",ExpressionUUID->
  "f146c1f0-3b2e-7941-ad83-b2949460acb1"],
 ")."
}], "Text",
