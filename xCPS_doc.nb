 TextAlignment->Center,ExpressionUUID->"edb0f616-7150-b946-8094-b64510d8e596"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{"CurrentFromVector", "[", "vector", "]"}], "[", 
     RowBox[{"tensors", ",", " ", "der"}], "]"}], "[", "Lagrangian", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"2a23e034-f1fb-5148-a0f4-5958b9ea4430"],
 StyleBox["\n",
  FontSize->5],
 "It returns the current associated with the vector field ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"v", "'"}]}]], "InlineCode",ExpressionUUID->
  "ff952b82-dfa0-024f-8332-ee52b54ab107"],
 " and the ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Lagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "7c1780c8-acc6-e345-9e0c-97307d5e6c98"],
 " given by the formula ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "v"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Iota]", "v"], "L"}], "-", 
    RowBox[{
     SubscriptBox["\[ImaginaryI]", 
      RowBox[{
       RowBox[{"VVFFromLieD", "[", "v", "]"}], "[", "tensors", "]"}]], 
     "\[CapitalTheta]"}]}]}]], "InlineCode",ExpressionUUID->
  "be575cce-f998-e24c-8349-216d72a805d7"],
 " where \[CapitalTheta] is the ",
 Cell[BoxData[
 "SymplecticPotential"], "InlineCode",ExpressionUUID->
  "ac4b3abf-cdad-164e-9bd1-682843b4ca62"],
 " (",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Lagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "cb39fa52-a1c5-e944-ab04-1a1a9aafd274"],
 "is understood as a top-form). There is an overall sign controlled by ",
 Cell[BoxData[
 "$NoetherCurrentSign"], "InlineCode",ExpressionUUID->
  "0c4ec579-c0be-d949-b001-b37bb3763707"],
 ".\n",
 StyleBox["\n",
  FontSize->3],
 "- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensors", "'"}]}]], "InlineCode",ExpressionUUID->
  "7d8f95c5-b4db-a846-9e17-591c83e8b860"],
 " is optional. It is a list of heads of tensors. If not specified, it \
considers all the tensors present in ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Lagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "2a436187-765f-1049-b4a5-3730684562d2"],
 ".\n- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "676062dd-9a3e-5844-9615-72c151d68df3"],
 " is optional. If not specified, it finds the only ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"45f2e2d0-e8ed-df4f-90e0-ae2ced1d33d5"],
 " present (if several are present, an error is thrown)."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
