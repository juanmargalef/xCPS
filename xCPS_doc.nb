Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertExactQ", "[", 
    RowBox[{"tensor", "[", "indices", "]"}], "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"aa6e5c3b-4ef6-124c-a898-584f353a09b6"],
 StyleBox["\n",
  FontSize->3],
 "It returns ",
 Cell[BoxData[
 "True"], "InlineCode",ExpressionUUID->"e5c9dfbd-fe06-ad43-b86c-f76365b968cd"],
 " if ",
 Cell[BoxData[
  RowBox[{"tensor", "[", "indices", "]"}]], "InlineCode",ExpressionUUID->
  "f224b8a7-0d48-3941-94fd-04acc61994ea"],
 " is vertically exact, meaning that there is another tensor such that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDiff", "[", 
    RowBox[{"tensor", "[", "indices", "]"}], "]"}], "=", 
   RowBox[{"Tensor", "[", "indices", "]"}]}]], "InlineCode",ExpressionUUID->
  "b7eddead-bd3c-7f42-9e46-14387ba9551e"],
 ". The function remains unevaluated otherwise. Notice that the placement of \
the indices is essential for this function."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
