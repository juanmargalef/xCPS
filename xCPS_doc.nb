Cell[TextData[{
 Cell[BoxData[
 "SymplecticCurrentOf1Form"], "InlineCode",ExpressionUUID->
  "3eccad24-5d0a-8948-afc0-3f186d5b10fa"],
 " considers constant all fields except ",
 Cell[BoxData[
 "A"], "InlineCode",ExpressionUUID->"07042f1b-7cab-f247-b9d4-eed403d6dd9b"],
 " (and its related fields). We have not established a variational relation \
between ",
 Cell[BoxData[
 "A"], "InlineCode",ExpressionUUID->"5ff7250b-150b-1d44-b4d7-0a7325ea84d3"],
 " and ",
 Cell[BoxData[
 "F"], "InlineCode",ExpressionUUID->"58c8f3c2-7a7b-954a-9be7-118fce60adde"],
 "! We can obtain the correct result in a couple of steps:"
