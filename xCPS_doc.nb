Cell[TextData[{
 "If we take the ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "5890797a-ca76-9144-a7de-dd6ac5214cf9"],
 " of a scalar, we have seen that new tensors are created. What happens if we \
take the ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "62b33c28-fc55-8340-a13a-4e4a53746fa4"],
 " of this new tensors? The chain rule is applied again and new tensors will \
emerge."
}], "Text",
 CellChangeTimes->{{3.9564203323793983`*^9, 3.956420399044283*^9}, {
   3.956671072722144*^9, 3.9566711232835584`*^9}, 
