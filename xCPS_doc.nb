    RowBox[{"We", " ", "define", " ", "a", " ", "1"}], "-", 
    RowBox[{
    "tensor", " ", "with", " ", "two", " ", "internal", " ", "indices"}]}], 
   " ", "*)"}], " "}], "\[IndentingNewLine]", 
