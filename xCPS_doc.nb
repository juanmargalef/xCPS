  StyleBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{"v", ",", "v"}], "]"}], "=", "0"}],
   FontColor->RGBColor[0.25098039215686274`, 0., 0.25098039215686274`]]], 
