Cell[TextData[{
 Cell[BoxData[
  StyleBox["$MasterTensors",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"fc218c37-4f2d-a94f-921b-1833f79e01b0"],
 "\nIt returns the list of defined tensors in the session that are neither \
exact vertical forms nor variational vector fields.\n\n",
 Cell[BoxData[
  StyleBox["$VertExactForms",
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"5e571ddf-b90b-f346-b56b-a8ffc13b497f"],
 "\nIt returns the list of tensors defined in the session as vertically exact \
forms."
}], "Text",
