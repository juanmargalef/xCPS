Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"showgrid", "[", 
    RowBox[{"x_", ",", "dlx_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "aux", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"aux", "=", 
       RowBox[{"{", 
        RowBox[{"x", ",", "dlx", ",", 
         RowBox[{"VertDiff", "[", "x", "]"}], ",", 
         RowBox[{"VertDiff", "[", "dlx", "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Input Form\>\"", ",", 
             RowBox[{"ToString", "@", 
              RowBox[{"InputForm", "@", 
               RowBox[{"aux", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
             RowBox[{"ToString", "@", 
