  3.9572035665982265`*^9}},ExpressionUUID->"eadeb7dc-039d-a74e-89b5-\
5def7291ebbf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["V", "i"], 
        SubscriptBox["\[PartialD]", "i"]}], ",", 
       RowBox[{
        SuperscriptBox["W", "j"], 
        SubscriptBox["\[PartialD]", "j"]}]}], "]"}], "k"], 
    SubscriptBox["\[PartialD]", "k"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["V", "m"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "m"], 
         SuperscriptBox["W", "k"]}]}], "-", 
       RowBox[{
        SuperscriptBox["W", "m"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "m"], 
         SuperscriptBox["V", "k"]}]}]}], ")"}], 
     SubscriptBox["\[PartialD]", "k"]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["L", "V"], 
       SuperscriptBox["W", "k"]}], ")"}], 
     RowBox[{
      SubscriptBox["\[PartialD]", "k"], 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["L", "W"], 
         SuperscriptBox["V", "k"]}], ")"}]}]}], 
     SubscriptBox["\[PartialD]", "k"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
