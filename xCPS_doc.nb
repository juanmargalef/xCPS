Cell[TextData[{
 "As expected, we have two metrics with their corresponding associated \
tensors (recall that they do not have an associated ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"4d1c238f-8b1c-4a4c-bf45-cd53d1bcfbc3"],
 " and, hence, all curvature tensors are zero)."
}], "Text",
