  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub Symmetries"],
  FontColor->RGBColor[0., 0., 1.]],
 " and will be further developed in ",
 StyleBox["Section ",
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox[
 CounterBox["Chapter", 
  "Section Variational Vectors and Variational vector fields"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Section Variational Vectors and Variational vector fields"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", 
  "Section Variational Vectors and Variational vector fields"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[").\n",
  FontColor->RGBColor[0., 0., 0.]],
 "\n",
 Cell[BoxData[
 Cell["CovD", "InlineCode",ExpressionUUID->
   "8dffd3a0-f23d-e445-b6aa-c91c105c787b"]], "InlineCode",ExpressionUUID->
  "a7b0e42a-3fe1-0942-a6a5-770c7539e81b"],
 " and ",
 Cell[BoxData[
 "VertInt"], "InlineCode",ExpressionUUID->
  "f6a176ca-b045-2943-96f6-ab6319e68e3f"],
 " commute (this is not always true, it is up to the user to check it) ."
}], "Text",
