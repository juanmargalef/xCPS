Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       SubscriptBox["EOM", "i"], ")"}], 
      SubscriptBox["B", 
