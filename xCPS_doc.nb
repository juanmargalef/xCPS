Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"VertInt", "[", "vvf", "]"}], "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"da3fad60-bf46-d742-80a3-584a7de83bca"],
 "\nIt returns the vertical interior derivative of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "1fcdf846-6fda-b047-81af-07e88f97d73b"],
 " along the variational vector field ",
 Cell[BoxData[
  RowBox[{
  "'", Cell[
   "vvf'", "InlineCode",ExpressionUUID->
    "db609870-5318-f442-9a81-631256007475"]}]], "InlineCode",ExpressionUUID->
  "bfba087a-a4bc-fc4f-aa56-97bf39450680"],
 ". ",
 Cell[BoxData[
  RowBox[{"VertInt", "[", "vvf", "]"}]], "InlineCode",ExpressionUUID->
  "6f3f2da8-46fb-9448-95f7-0f00f1a660ee"],
 " is a graded derivation with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", 
    RowBox[{"VertInt", "[", "vvf", "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"VertDeg", "[", "vvf", "]"}], "-", "1"}]}]], "InlineCode",
  ExpressionUUID->"0b915358-ae8f-064c-ae1e-10e36d1cee1e"],
 ". We denote it with the symbol \[ImaginaryI] (\[EscapeKey]+ii+\[EscapeKey])."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
