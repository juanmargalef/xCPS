645d4aac263d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"TotalDerivativeOfPotential", "[", "expr", "]"}], " "}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"8668140e-bbb4-6c42-9898-ffb19bfde600"],
 "\nIt extracts the total derivative potential \[CapitalTheta] of an \
expression of the form ",
 Cell[BoxData[
  RowBox[{"expr", "=", 
   RowBox[{"expr2", "+", 
    RowBox[{
     RowBox[{"TotalDerivativeOf", "[", "der", "]"}], "[", "\[CapitalTheta]", 
     "]"}]}]}]], "InlineCode",ExpressionUUID->
  "9a123062-c388-fc4c-9946-74a075cae42d"],
 " or ",
 Cell[BoxData[
  RowBox[{"expr", "=", 
   RowBox[{"expr2", "+", 
    RowBox[{
     RowBox[{"der", "[", "ind", "]"}], "[", 
     RowBox[{"Keep", "[", "\[CapitalTheta]", "]"}], "]"}]}]}]], "InlineCode",
  ExpressionUUID->"ef75f0c9-2fc1-914a-8db9-80368f3784b0"],
 "."
}], "Text",
