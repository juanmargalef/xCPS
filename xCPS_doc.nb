Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Remark:",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"VertDiff", "[", 
   RowBox[{"Inv", "[", "g", "]"}], "]"}]], "InlineCode",ExpressionUUID->
  "cb8e3d0c-4f42-5346-b74c-54d4c7b658d0"],
 " returns ",
 Cell[BoxData[
 "dlg"], "InlineCode",ExpressionUUID->"96a110b6-04a6-3540-b074-862820621cc9"],
 ". This is so because ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Inv", "[", "g", "]"}], "=", "g"}]], "InlineCode",ExpressionUUID->
  "72ae2780-7bda-6749-b489-c4c1ffc14509"],
 " is first evaluated, and then ",
 Cell[BoxData[
 "VertDiff"], "InlineCode",ExpressionUUID->
  "b034b1e1-db31-b14f-b217-0c27cd360157"],
 " is applied. To obtain ",
 Cell[BoxData[
 "dlInvg"], "InlineCode",ExpressionUUID->
  "cbba95c7-ccd7-6c47-b3f0-68b3b2c0752b"],
 " we use ",
 Cell[BoxData[
  RowBox[{"VertDiff", "[", "Invg", "]"}]], "InlineCode",ExpressionUUID->
  "b8b5d8b9-05b1-ea47-b0fa-72cf2aad6f44"],
 "."
}], "Item",
 CellChangeTimes->{{3.9576076658627195`*^9, 3.957607696396923*^9}, {
