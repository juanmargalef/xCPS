Cell["Indeed, the previous computation shows that", "Text",
 CellChangeTimes->{{3.954949541405796*^9, 3.954949622558178*^9}, {
   3.95510151305056*^9, 3.955101567545923*^9}, {3.9554573664921703`*^9, 
