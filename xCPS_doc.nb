Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"VertBracket", "[", 
    RowBox[{"vvf1", ",", " ", "vvf2"}], "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"3d0bbcd6-d2a8-2548-9ced-7a68f8d272dc"],
 "\nIt represents the vertical Lie bracket of the variational vector fields ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf1", "'"}]}]], "InlineCode",ExpressionUUID->
  "775fcaa9-c8d7-aa48-a06d-c77f09acf4ff"],
 " and ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"vvf2", "'"}]}]], "InlineCode",ExpressionUUID->
  "540aab3c-b405-3c47-a7d6-4de8e01e539c"],
 ". It is a supper-anticommutative bilinear product:\n",
 StyleBox["\n",
  FontSize->6],
 "   ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    RowBox[{
     RowBox[{"\[LeftDoubleBracket]", 
      RowBox[{"vvf1", ",", "vvf2"}], "\[RightDoubleBracket]"}], "=", 
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"VertDeg", "[", "VVF1", "]"}], 
         RowBox[{"VertDeg", "[", "VVF2", "]"}]}]], "\[LeftDoubleBracket]", 
       RowBox[{"vvf2", ",", "vvf1"}], "\[RightDoubleBracket]"}]}]}]], 
    "InlineCode",ExpressionUUID->"278e0492-d038-8847-9f2d-c477bca04263"]], 
    "InlineCode",ExpressionUUID->"0772e7c4-5761-ab4d-959a-cb7192f2b64c"], 
   TraditionalForm]],ExpressionUUID->"2f9c9fa0-7ac3-cf4a-a77f-b88e05be7575"]
}], "Text",
