Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"FirstVariationOf1Form", "[", 
     RowBox[{"tensors", ",", " ", "der", ",", " ", "options"}], "]"}], "[", 
    "dlLagrangian", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"f3e239b6-cd63-f948-9d85-967eb8a1c7b6"],
 "\nIt computes the first variation of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"dlLagrangian", "'"}]}]], "InlineCode",ExpressionUUID->
  "85503d99-d058-564c-9c67-d4e8c5d35f8f"],
 " keeping the total derivative term.\n",
 StyleBox["\n",
  FontSize->3],
 "- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"fields", "'"}]}]], "InlineCode",ExpressionUUID->
  "cd5a3108-e576-234b-9f95-bb2581507678"],
 ": optional argument to indicate the fields to be considered as dynamical. \
If not specified, all fields are considered dynamic.\n- ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "f41fb283-5bf9-de47-a229-f3c126f8579f"],
 ": optional argument to specify the ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"113895e3-d74f-5342-a5ff-ec99aa0d21d7"],
 " to be used by ",
 Cell[BoxData[
 "FirstVariation"], "InlineCode",ExpressionUUID->
  "bf873adf-62fa-a14e-81e3-b9ae912d3f44"],
 ".\n- Options:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"Simplification", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"22f090b6-cdd8-5946-8490-c410c11a9872"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ContractMetric", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"cd81e125-f334-4b43-85f5-53a6d16bb112"],
 "."
}], "Text",
