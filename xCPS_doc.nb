 TextAlignment->Center,ExpressionUUID->"9240d4d2-cc77-484f-8cc1-4f84cb62d9e9"],

Cell[TextData[{
 "Notice that in the \[Diamond] equality we have used that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDiff", "[", "\[Delta]", "]"}], "==", "0"}]], "InlineCode",
  ExpressionUUID->"9d50fd3b-d91f-fa47-8342-6798d61bf222"],
 ". This is not true for a metric! "
}], "Text",
