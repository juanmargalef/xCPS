Cell[TextData[{
 "This is a very particular case since it is the covariant derivative of a \
scalar, which is equivalent to its horizontal exterior derivative. Thus, it \
does not depend on the ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"cf835656-5322-2844-bb73-001571357419"],
 " (this type of objects are sometimes called concomitants). For more general \
tensors, it does depend on the ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"e53a9440-e5eb-fc45-b395-a9fae8e94223"],
 ", so additional variational relations appear:"
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, 
