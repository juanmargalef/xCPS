  RowBox[{"{", 
   RowBox[{"dlInvmetric", ",", "VariationalVectorInvmetric"}], "}"}]], 
  "InlineCode",ExpressionUUID->"9de653c5-2064-d04d-8975-fb8f7986b489"],
 " are used."
}], "Text",
