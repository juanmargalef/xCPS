Cell[BoxData[
 RowBox[{
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"i", "=", "1"}], "N"], 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      SubscriptBox["EOM", "i"], ")"}], 
     SubscriptBox["B", 
      RowBox[{"(", "i", ")"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox["\[Phi]", "i"]}], ")"}], 
     SubscriptBox["B", 
      RowBox[{"(", "i", ")"}]]]}]}], "+", 
  RowBox[{"TotalDerivativeOfCovDder", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["NormalOfCovDder", "b"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "N"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}], 
         SubscriptBox["m", "i"]], 
        RowBox[{
         SubscriptBox[
          SuperscriptBox[
           RowBox[{"(", 
            SubscriptBox["R", "ij"], ")"}], 
           RowBox[{
            RowBox[{
             SubscriptBox["ba", "2"], "..."}], 
            SubscriptBox["a", "j"]}]], 
          SubscriptBox["B", 
           RowBox[{"(", "i", ")"}]]], 
         SubscriptBox["\[Del]", 
          SubscriptBox["a", "2"]]}]}]}]}], "..."}], 
    RowBox[{
     SubscriptBox["\[Del]", 
      SubscriptBox["a", "j"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["\[Phi]", "i"]}], ")"}], 
      SubscriptBox["B", 
       RowBox[{"(", "i", ")"}]]]}]}], "]"}]}]], "DisplayFormulaNumbered",
