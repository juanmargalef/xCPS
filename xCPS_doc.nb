Cell["\<\
It is essential to understand that raising/lowering indices is done with the \
main metric, not the frozen one.\
\>", "Text",
 CellChangeTimes->{{3.9524363958877215`*^9, 
  3.952436400634348*^9}},ExpressionUUID->"9de9f55b-0ae1-c640-83c2-\
61afeac61a26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"Invg2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", "\"\<\[NotEqual]\>\"", ",", 
   RowBox[{"g2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", "\"\<=\>\"", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"g2", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "//", 
     RowBox[{"SeparateMetric", "[", "]"}]}], "//", "ScreenDollarIndices"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VertDiff", "[", 
   RowBox[{"Invg2", "[", 
    RowBox[{"a", ",", "b"}], "]"}], "]"}], "==", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"VertDiff", "[", 
     RowBox[{"Invg2", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "]"}], "//", 
    RowBox[{"ExpandVertDiff", "[", "]"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"VertDiff", "[", 
    RowBox[{"Invg2", "[", 
     RowBox[{"a", ",", "b"}], "]"}], "]"}], ",", "\"\<\[NotEqual]\>\"", ",", 
   RowBox[{
    RowBox[{"dlg2", "[", 
     RowBox[{"a", ",", "b"}], "]"}], "==", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"dlg2", "[", 
        RowBox[{"a", ",", "b"}], "]"}], "//", 
       RowBox[{"SeparateMetric", "[", "]"}]}], "//", "ScreenDollarIndices"}], 
     ")"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9486683069790535`*^9, 3.9486684592810965`*^9}, {
