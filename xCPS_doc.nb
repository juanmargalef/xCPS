Cell[TextData[{
 "We need to apply Bianchi's identity. We could use ",
 StyleBox["TInvar",
  FontWeight->"Bold"],
 " or ",
 StyleBox["xTras",
  FontWeight->"Bold"],
 ", but to make this notebook self-contained, we use ",
 "the following code (based on ",
 ButtonBox["Teake's code",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://groups.google.com/g/xact/c/0ZJHUmFj7WI/m/HZ-4hsdkddMJ"], 
    None},
  ButtonNote->"https://groups.google.com/g/xact/c/0ZJHUmFj7WI/m/HZ-4hsdkddMJ"],
 ")."
}], "Text",
 CellChangeTimes->{{3.957597492801111*^9, 3.9575975010237722`*^9}, {
  3.958248737629963*^9, 3.958248772852585*^9}, {3.9582489789458046`*^9, 
  3.9582489789587975`*^9}, {3.9582490523405*^9, 3.958249052352495*^9}, {
  3.958252218092331*^9, 
  3.958252218367468*^9}},ExpressionUUID->"74541cc7-b000-134e-9c85-\
ff69439e2878"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"BianchiRule1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Ordering", "[", 
        RowBox[{"{", 
         RowBox[{"b", ",", "c", ",", "d"}], "}"}], "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], ")"}]}], "->", 
    RowBox[{
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "-", 
     RowBox[{"RiemannLCDer", "[", 
      RowBox[{"a", ",", "d", ",", "b", ",", "c"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BianchiRule2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LCDer", "[", "a_", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"b_", ",", "c_", ",", "d__"}], "]"}]}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Ordering", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], ")"}]}], "->", 
    RowBox[{
     RowBox[{
      RowBox[{"LCDer", "[", "b", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"LCDer", "[", "c", "]"}], "@", 
      RowBox[{"RiemannLCDer", "[", 
       RowBox[{"a", ",", "b", ",", "d"}], "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BianchiContracted1", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"LCDer", "[", 
         RowBox[{"-", "e"}], "]"}], "@", 
        RowBox[{"RiemannLCDer", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "c"}], ",", 
          RowBox[{"-", "d"}], ",", "e"}], "]"}]}], ",", 
       RowBox[{"$RicciSign", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "c"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "a"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "c"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BianchiContracted2", "=", 
    RowBox[{"MakeRule", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"LCDer", "[", 
          RowBox[{"-", "b"}], "]"}], "@", 
         RowBox[{"RicciScalarLCDer", "[", "]"}]}], ",", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"LCDer", "[", 
           RowBox[{"-", "a"}], "]"}], "[", 
          RowBox[{"RicciLCDer", "[", 
           RowBox[{"a", ",", 
            RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ApplyBianchi", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ToCanonical", "[", "expr", "]"}], "//.", "BianchiRule1"}], "//.",
       "BianchiRule2"}], "//.", "BianchiContracted1"}], "//.", 
    "BianchiContracted2"}], "//", "ToCanonical"}]}]}], "Input",
 CellChangeTimes->{{3.954346818444729*^9, 3.9543468263914833`*^9}, {
   3.954520338633934*^9, 3.954520339253887*^9}, {3.954950082909952*^9, 
   3.95495015823332*^9}, {3.954950612661337*^9, 3.954950633047289*^9}, 
   3.955094875789009*^9, {3.9554685380277023`*^9, 3.955468612640909*^9}, {
   3.9554686467856827`*^9, 3.955468648612913*^9}, {3.9575974857546988`*^9, 
   3.9575974891136603`*^9}},
 CellLabel->
  "In[1352]:=",ExpressionUUID->"622c0d69-71ee-0345-bcf1-281b61d20e54"],

