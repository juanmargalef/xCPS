Cell[TextData[{
 "Here we need to apply the Bianchi identities. This can be done \
systematically with other packages (like ",
 StyleBox["TInvar",
  FontWeight->"Bold"],
 " or ",
 StyleBox["xTras",
  FontWeight->"Bold"],
 ") but to make this notebook self-contained, we define ",
 Cell[BoxData[
  StyleBox["ApplyBianchi",
   FontColor->RGBColor[0., 0., 0.]]], "InlineCode",
  FontColor->RGBColor[0., 0., 1.],ExpressionUUID->
  "89a4d803-c83b-f34c-a45b-be0118464924"],
 StyleBox[":",
  FontColor->RGBColor[0., 0., 0.]]
}], "Text",
 CellChangeTimes->{{3.950884789162279*^9, 3.950884811936074*^9}, {
   3.950891554263384*^9, 3.9508915554541874`*^9}, {3.951245973060213*^9, 
   3.95124598459073*^9}, {3.951247202935972*^9, 3.9512472071753654`*^9}, 
   3.952344220674676*^9, {3.9546642560987206`*^9, 3.9546642611099405`*^9}, 
   3.9580413337448425`*^9, {3.9580659376978874`*^9, 3.9580659538133087`*^9}, {
   3.986747079862543*^9, 
   3.986747081933771*^9}},ExpressionUUID->"fc5c6e41-1b14-204b-8a7c-\
387b219f9706"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"BianchiContracted1", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"LCDer", "[", 
         RowBox[{"-", "e"}], "]"}], "@", 
        RowBox[{"RiemannLCDer", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "c"}], ",", 
          RowBox[{"-", "d"}], ",", "e"}], "]"}]}], ",", 
       RowBox[{"$RicciSign", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "c"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "a"}], "]"}], "@", 
           RowBox[{"RicciLCDer", "[", 
            RowBox[{
             RowBox[{"-", "c"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BianchiContracted2", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"LCDer", "[", 
         RowBox[{"-", "b"}], "]"}], "@", 
        RowBox[{"RicciScalarLCDer", "[", "]"}]}], ",", 
       RowBox[{"2", 
        RowBox[{
         RowBox[{"LCDer", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"RicciLCDer", "[", 
          RowBox[{"a", ",", 
