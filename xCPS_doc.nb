Cell[TextData[{
 "There is in fact a better approach to check the formulas: to consider the \
tensor to be expanded, express it in terms of ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"0d4f00be-e21f-7d48-9b03-ebd27e2f8e03"],
 " (with ",
 Cell[BoxData[
 "ChangeCovD"], "InlineCode",ExpressionUUID->
  "b6288886-4c02-854a-8f49-9875d4b246d1"],
 " and other commands like ",
 Cell[BoxData[
 "ChangeCurvature"], "InlineCode",ExpressionUUID->
  "f53f262f-bb81-c64d-8cb1-11838631a24f"],
 ", ",
 Cell[BoxData[
 "WeylToRiemann"], "InlineCode",ExpressionUUID->
  "6665407f-a21b-374f-b3d0-269fb6ed430f"],
 "...) and use the fact that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDiff", "@", "PD"}], "=", 
   RowBox[{"PD", "@", "VertDiff"}]}]], "InlineCode",ExpressionUUID->
  "61bbb985-89ed-294a-acf0-a8a263088e1b"],
 ". Obviously this is a very slow procedure and that is why ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "0704c72d-30b8-6d47-84b2-851b4c22a29f"],
 " includes predefined expansion, but we have included in Section ",
 StyleBox[ButtonBox["A.",
  BaseStyle->"Hyperlink",
  ButtonData->"Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Section Ap Checking ExpandVertDiff formulas"],
  FontColor->RGBColor[0., 0., 1.]],
 " ",
 StyleBox["of the Appendix all the verifications of all the formulas used by",
  FontWeight->"Normal",
  FontColor->RGBColor[0., 0., 0.]],
 " ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "8d8a5ea1-1065-ca4a-85ac-02beeed86458"],
 "."
}], "Text",
 CellChangeTimes->{{3.9323339851463175`*^9, 3.9323339972403483`*^9}, {
   3.932389228372264*^9, 3.932389228543839*^9}, {3.948667861916671*^9, 
