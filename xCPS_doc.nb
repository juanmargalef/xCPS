Cell[TextData[{
 "Since each manifold has only one ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"554a67a7-cf43-b045-b494-35f3408bed5f"],
 " operator defined (although remember that it just represents one of the \
many ",
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"a9122979-4a23-2245-844a-46b7a0994c87"],
 " without curvature and without torsion on the manifold), there is only one ",
 Cell[BoxData[
  RowBox[{"NormalOfCovD", "[", "PD", "]"}]], "InlineCode",ExpressionUUID->
  "9d3d09ad-3b94-9f45-962d-74ff8b1f566f"],
 " and ",
 Cell[BoxData[
  RowBox[{"TotalDerivativeOf", "[", "PD", "]"}]], "InlineCode",ExpressionUUID->
  "35a44236-2a08-b14a-8e76-2b2095105965"],
 " on each manifold. We can retrieve them from the manifold as follows:"
}], "Text",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, {
   3.957534764129612*^9, 3.9575348416446743`*^9}, {3.9575348767962017`*^9, 
   3.9575348829220963`*^9}, {3.9575349521711273`*^9, 3.957535047492895*^9}, {
   3.9575351040976562`*^9, 3.9575351486400642`*^9}, {3.9575352873648033`*^9, 
   3.957535306412796*^9}, {3.957598803111659*^9, 3.9575988117046857`*^9}, 
   3.9583406560744915`*^9, {3.958340708920023*^9, 
   3.958340730558422*^9}},ExpressionUUID->"b37e1f4b-4986-c641-90f7-\
bcd9bc02b911"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"NormalOfManifold", "[", "Manifold", "]"}], " "}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"ccb69dda-d6ef-934b-9294-5bbdaa77e251"],
 "\nIt returns ",
 Cell[BoxData[
 "FiducialNormalOfManifold"], "InlineCode",ExpressionUUID->
  "9353a134-15a8-6b47-9a4e-0886edcc3543"],
 ". This is the normal tensor associated with ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"d1f49446-c809-5a4b-a29f-de9796fb007f"],
 " over ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Manifold", "'"}]}]], "InlineCode",ExpressionUUID->
  "b2d31f4c-ef21-f04b-9ee0-2e28c46deda1"],
 " (notice that ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"117e29b2-b389-7142-ad93-91f2e4e0bb02"],
 " is defined over every manifold).\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"TotalDerivativeOfManifold", "[", "Manifold", "]"}], " "}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"a4a5bc61-d811-5e48-b525-3c052821aa1f"],
 "\nIt returns the head ",
 Cell[BoxData[
 "TotalDerivativeManifold"], "InlineCode",ExpressionUUID->
  "3ccf7c12-9d31-f549-b522-c5085db9fe04"],
 ". This is the ",
 Cell[BoxData[
 "TotalDerivative"], "InlineCode",ExpressionUUID->
  "3abac3c9-1727-1049-935d-51574dcc375a"],
 " associated with ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"1500a24d-05c4-b149-a515-2b138acd216f"],
 " over ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"Manifold", "'"}]}]], "InlineCode",ExpressionUUID->
  "6ffe90a1-9595-8344-ae10-881c8e46cecc"],
 " (notice that ",
 Cell[BoxData[
 "PD"], "InlineCode",ExpressionUUID->"283b1375-ab1d-1941-98e9-31470b9c894f"],
 " is defined over every manifold)."
}], "Text",
