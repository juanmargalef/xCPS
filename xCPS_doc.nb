Cell[TextData[{
 "This makes intuitive sense since ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "d9c38f03-1e41-af4e-b9c3-015b90c84350"],
 " \[OpenCurlyDoubleQuote]appears in the denominator\[CloseCurlyDoubleQuote] \
in ",
 Cell[BoxData[
 "VariationalVector"], "InlineCode",ExpressionUUID->
  "3c293ad3-335f-cb4e-bb50-4b798f09b854"],
 ". We will see later on Subsection ",
 StyleBox[
 CounterBox["Chapter", "sub expandvertint of VVFQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub expandvertint of VVFQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "sub expandvertint of VVFQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"sub expandvertint of VVFQ"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "sub expandvertint of VVFQ"],
  FontColor->RGBColor[0., 0., 1.]],
 " that this definition is the right one."
}], "Text",
