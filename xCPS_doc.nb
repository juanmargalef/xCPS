Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"MakeVertRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lhs", ",", " ", "rhs"}], "}"}], ",", " ", "opts"}], "]"}],
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",
  FontWeight->"Bold",ExpressionUUID->"b877b08d-2bd9-734d-b4f4-2e3aee326a68"],
 StyleBox["\n",
  FontSize->5],
 "It calls ",
 Cell[BoxData[
 "MakeRule"], "InlineCode",ExpressionUUID->
  "79ea1662-941a-4342-b1d9-3a81cffc147b"],
 " twice: one for ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lhs", "\[RightArrow]", "rhs"}], "}"}]], "InlineCode",
  ExpressionUUID->"6ea09263-7d93-5245-a7a8-568a04178012"],
 " and the other for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[DifferentialD]", "lhs"}], "\[RightArrow]", 
     RowBox[{
      RowBox[{"ExpandVertDiff", "[", "opts", "]"}], "[", 
      RowBox[{"VertDiff", "[", "rhs", "]"}], "]"}]}], "}"}], "."}]], 
  "InlineCode",ExpressionUUID->"e5c5de1d-826a-7c4a-a15e-3fa9f990d621"],
 "\n",
 StyleBox["\n",
  FontSize->3],
 "- Options: Same as for MakeRule and ExpandVertDiff."
}], "Text",
