Cell[TextData[{
 "But we can achieve the same result quickly adding the variational relation \
between ",
 Cell[BoxData[
 "A"], "InlineCode",ExpressionUUID->"2ffb29c7-1521-974d-8f5c-8153ea12f383"],
 " and ",
 Cell[BoxData[
 "F"], "InlineCode",ExpressionUUID->"4b8b2ddc-74b4-bf45-ae7b-bd0e2090ec3b"],
 " (",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[DifferentialD]", "A"}], "=", "0"}]], "InlineCode",
  ExpressionUUID->"f9c7f63c-17b5-b54b-b013-f27b8932bc97"],
 " implies ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[DifferentialD]", "F"}], "=", "0"}]], "InlineCode",
  ExpressionUUID->"6b5929f8-23c1-f145-bc37-6ecc16f1f61e"],
 ", but the converse is not true)."
}], "Text",
 CellChangeTimes->{{3.9550369902336254`*^9, 3.9550370283257523`*^9}, {
  3.9550372318240013`*^9, 3.955037308720684*^9}, {3.9575976418285513`*^9, 
