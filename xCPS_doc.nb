a325b9c60a15"],

Cell[TextData[{
 "If",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"VertDeg", "[", "Tensor", "]"}], "=", "0"}]], "InlineCode",
  FontWeight->"Bold",ExpressionUUID->"33a54517-ab85-5640-a36c-7b980b07cc7e"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ImaginaryI]", "vvf"], "tensor"}], "=", "0"}]], 
  "InlineCode",ExpressionUUID->"d928c903-1b99-e349-8d42-2dfc6619b948"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
