Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"TotalDerivativeOfCovD", "[", "der", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"6a48eace-2de4-5643-933e-704d3deead17"],
 "\nIt returns the total derivative head (divergence term) associated with \
the covariant derivative ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "6ad60ccf-24bf-7942-9384-8fab3cb70cd4"],
 ". It is the one used in the first variation of a Lagrangian.\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"NormalOfCovD", "[", "der", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"6edec133-0d59-6743-ad09-e83d15f37b52"],
 "\nIt returns the fiducial normal vector associated with the covariant \
derivative operator ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "8cd0a470-fc84-3f4a-be7a-c090ca46730f"],
 ".\n\nFor both functions, if ",
 Cell[BoxData[
  RowBox[{"der", "=", "PD"}]], "InlineCode",ExpressionUUID->
  "8340ee7a-9f55-bc41-8340-80db44ca5b3a"],
 " and multiple manifolds are defined, the arguments must be ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"PD", ",", " ", "index"}], "]"}]], "InlineCode",ExpressionUUID->
  "29aa8171-8032-cf4f-9b8f-4d9494936556"],
 " or ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"PD", ",", " ", "manifold"}], "]"}]], "InlineCode",ExpressionUUID->
  "a882ce03-f397-0843-8543-6790b09c132f"],
 " to disambiguate."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
   3.953086717072216*^9, 3.953086744422722*^9}, 3.9544805056591763`*^9, {
   3.954505009170573*^9, 3.954505022966942*^9}, {3.954649773421836*^9, 
   3.9546497859023123`*^9}, {3.9546502996505127`*^9, 3.954650347420864*^9}, {
   3.9546503897820797`*^9, 3.954650414192841*^9}, {3.956015007811576*^9, 
   3.9560150261204276`*^9}, {3.9560150722551556`*^9, 3.956015075518139*^9}, {
   3.956015213693786*^9, 3.9560152180386033`*^9}, {3.956015296946066*^9, 
   3.9560153267933507`*^9}, {3.956015544396258*^9, 3.9560155474485793`*^9}, {
   3.956744829317385*^9, 3.9567449060989914`*^9}, {3.95674552725744*^9, 
   3.9567455326786346`*^9}, {3.9575861748855543`*^9, 
   3.9575861748855543`*^9}, {3.957586245968608*^9, 3.9575862629014635`*^9}, {
   3.9575870381069503`*^9, 3.9575870505180283`*^9}, {3.957612683290888*^9, 
   3.957612720386752*^9}, {3.957673415174498*^9, 3.9576734352088966`*^9}, {
   3.9578842499816055`*^9, 3.9578842772806187`*^9}, {3.958235626850809*^9, 
   3.9582357099255295`*^9}, {3.9595774757036858`*^9, 3.95957749625049*^9}, {
   3.960299474544161*^9, 3.9602994799139767`*^9}},
 Background->RGBColor[
  1, 0.882353, 
   0.823529],ExpressionUUID->"69216d7c-46ae-7343-967c-21da80a214ba"],

Cell[TextData[{
 StyleBox["When performing the first variation, we obtain the InertHead ",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
  RowBox[{"TotalDerivativeOfCovD", "[", "LCDer", "]"}]], "InlineCode",
  ExpressionUUID->"c3c326dc-dc91-a04f-ae86-70782c376e68"],
 StyleBox["=",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
 "TotalDerivativeOfLCDer"], "InlineCode",ExpressionUUID->
  "4b3809f7-244c-d646-8b3b-ab1a7dd7edba"],
 StyleBox[". It indicates that the term is a total derivative (a divergence) \
with respect to ",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
 "LCDer"], "InlineCode",ExpressionUUID->
  "a649bc9a-1092-7942-a51f-55a645e5385a"],
 StyleBox[". However, in order for the indices to match and obtain a scalar, \
we need a covector that keeps tracks of the index and the ",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
 "CovD"], "InlineCode",ExpressionUUID->"2b9b5ad3-6393-564e-841d-132e241cd364"],
 StyleBox[". This is done with N",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
  RowBox[{"ormalOfCovD", "[", "LCDer", "]"}]], "InlineCode",ExpressionUUID->
  "617a1e61-e138-5543-a317-09170525f1ad"],
 StyleBox["=",
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
 "NormalOfCovDLCDer"], "InlineCode",ExpressionUUID->
  "3432d58a-bf4b-3242-8700-2ec76118f082"],
 ".\n\nAs we explained in Subsection",
 StyleBox[" ",
  FontColor->RGBColor[0.25098039215686274`, 0., 0.5019607843137255]],
 StyleBox[
 CounterBox["Chapter", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Section DefTensor"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Section", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[ButtonBox[".",
  BaseStyle->"Hyperlink",
  ButtonData->"Section DefTensor"],
  FontColor->RGBColor[0., 0., 1.]],
 StyleBox[
 CounterBox["Subsection", "Sub FindPotentialDivergence"],
  FontColor->RGBColor[0., 0., 1.]],
 " , ",
 Cell[BoxData[
  RowBox[{"NormalOfCovD", "[", "der", "]"}]], "InlineCode",ExpressionUUID->
  "b167a1b9-d7a5-5e49-9ce9-c705f40e3eb4"],
 " keeps track of the index of ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"der", "'"}]}]], "InlineCode",ExpressionUUID->
  "58e60851-5ca4-9c4c-be3b-dd6ea412425a"],
 ". Moreover, for metric ",
 Cell[BoxData[
 "CovDs"], "InlineCode",ExpressionUUID->
  "b6f349c2-1d9a-2440-81f3-4b0a20f27592"],
 ", this tensor is also the one appearing when integrating over a manifold \
with boundary and applying Stokes\[CloseCurlyQuote] theorem"
}], "Text",
 CellChangeTimes->{{3.9533898085400696`*^9, 3.953389914341772*^9}, {
   3.953390160465475*^9, 3.9533901679825096`*^9}, 3.9546502778835173`*^9, {
   3.9546503587962446`*^9, 3.9546503733999925`*^9}, 3.9560149677622166`*^9, {
   3.957276930516011*^9, 3.9572769364976835`*^9}, {3.9572770834380407`*^9, 
   3.957277111630619*^9}, 3.9572772004915733`*^9, {3.9573965112350826`*^9, 
   3.957396514629056*^9}, {3.9575862668952847`*^9, 3.9575862695863037`*^9}, {
   3.9575871963693204`*^9, 3.9575873192325*^9}, 3.9576700408795104`*^9, {
   3.9576700730889006`*^9, 3.957670108310593*^9}, 3.957958508600348*^9, {
   3.9582357247450294`*^9, 3.9582357911218967`*^9}, {3.958612958417062*^9, 
