Cell[TextData[{
 "If we add indices to the previous expressions, the tensors involving ",
 Cell[BoxData[
 "Invg"], "InlineCode",ExpressionUUID->"6660f54e-9147-2b41-bc92-7c7bcfcd9e48"],
 ", are automatically turned into their equivalent tensors involving the \
metric but multiplied by the sign ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "NumberOfMetricsInvolved"]],
  CellChangeTimes->{{3.9564270693538494`*^9, 3.956427080876587*^9}, 
