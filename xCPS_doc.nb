      "vvf", " ", "not", " ", "necessarily", " ", "a", " ", "Noether", " ", 
       "symmetry"}], ")"}]}]}]}], TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.950890985558349*^9, 3.950891036705971*^9}, {
