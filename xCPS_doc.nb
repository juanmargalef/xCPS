Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{
    RowBox[{"ExpandVertDiff", "[", "options", "]"}], "[", "expr", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"69d30bf0-4042-474b-a78e-e22eb2187055"],
 StyleBox["\n",
  FontColor->RGBColor[
   0.5019607843137255, 0.5019607843137255, 0.5019607843137255]],
 StyleBox["It expands ",
  FontColor->RGBColor[0., 0., 0.]],
 "the vertical exterior derivatives appearing in ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"expr", "'"}]}]], "InlineCode",ExpressionUUID->
  "baac2de2-4e2e-4643-942f-58b4831d117e"],
 ".\n",
 StyleBox["\n",
  FontSize->5],
 "The possible options are:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"SeparateMetric", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"1e1fc220-567a-c64e-9a52-3ebdeae7938a"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"Explode", "\[RightArrow]", "True"}]], "InlineCode",ExpressionUUID->
  "bff08df1-3251-a447-891a-20e277e38e78"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiffCovD", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"8a4c5964-0b5f-384c-a861-54ad95a531ca"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiffLieD", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"3a0fb06e-8d5d-0542-9934-06fb25261a9c"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiffBracket", "\[RightArrow]", "True"}]], "InlineCode",
  ExpressionUUID->"23b194e6-dfb6-4048-87c1-a679bae84471"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiffTotalDerivative", "\[Rule]", "True"}]], "InlineCode",
  ExpressionUUID->"681782cb-9cc8-f942-be52-a97b5df9055b"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ExpandVertDiffScalarFunction", "\[RightArrow]", "True"}]], 
  "InlineCode",ExpressionUUID->"36904547-db8d-714a-b55d-12f5818ac768"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"ConstantTensors", "\[RightArrow]", 
   RowBox[{"{", "}"}]}]], "InlineCode",ExpressionUUID->
  "e21ab5e2-cb44-b448-8720-c6890a2a7034"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"NonConstantTensors", "\[RightArrow]", 
   RowBox[{"{", "}"}]}]], "InlineCode",ExpressionUUID->
  "7316bf24-9732-af4c-9515-d4c45d6655a1"],
 "\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"HoldExpandVertDiff", "\[RightArrow]", "None"}]], "InlineCode",
  ExpressionUUID->"3ffb9db2-942d-d940-8d33-c9e4e7c6cb92"]
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
