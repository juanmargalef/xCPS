Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EnergyMomentum", "[", "Lscalar", "]"}], "//", "ContractMetric"}], 
  "//", "Simplification"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EOM", "[", "g", "]"}], "[", "Lscalar", "]"}], "//", 
   "ContractMetric"}], "//", "Simplification"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EOM", "[", 
      RowBox[{"Inv", "[", "g", "]"}], "]"}], "[", "Lscalar", "]"}], "//", 
    "ContractMetric"}], "//", "Simplification"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Inv", "[", "g", "]"}], "=", 
    RowBox[{
    "g", " ", "is", " ", "first", " ", "evaluated", " ", "before", " ", 
     "being", " ", "used", " ", "by", " ", "EOM"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$UseInverseMetric", "=", "True"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EnergyMomentum", "[", "Lscalar", "]"}], "//", "ContractMetric"}],
    "//", "Simplification"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"This", " ", "does", " ", "not", " ", "change"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EOM", "[", "g", "]"}], "[", "Lscalar", "]"}], "//", 
    "ContractMetric"}], "//", "Simplification"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "These", " ", "equations", " ", "change", " ", "the", " ", "sign"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EOM", "[", 
     RowBox[{"g", "[", 
      RowBox[{"e", ",", "f"}], "]"}], "]"}], "[", "Lscalar", "]"}], "//", 
   "ContractMetric"}], "//", "Simplification", " ", 
  RowBox[{"(*", " ", 
   RowBox[{"We", " ", "can", " ", "add", " ", "indices"}], " ", 
   "*)"}]}]}], "Input",
