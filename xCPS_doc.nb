Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Remark:",
  FontWeight->"Bold"],
 " Imaginary tensors/function do not change the ",
 Cell[BoxData[
 "Hermitian"], "InlineCode",ExpressionUUID->
  "992bd327-bd6b-304a-8e7a-4ac5a50bc388"],
 "/",
 Cell[BoxData[
 "Antihermitian"], "InlineCode",ExpressionUUID->
  "c68ff1eb-9924-734a-a9e6-b97b500cb849"],
 " character, they only introduce a sign ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], 
   RowBox[{"#", 
    RowBox[{"{", 
     RowBox[{"Imaginary", " ", "objects"}], "}"}]}]]], "InlineCode",
  ExpressionUUID->"ef5e711f-de89-3544-aa4d-82f3f96e0485"],
 " since we follow the convention (because it fits better with the ",
 StyleBox["xAct",
  FontWeight->"Bold"],
 " formalism) that is it ",
 Cell[BoxData[
 "Hermitian"], "InlineCode",ExpressionUUID->
  "c54afbb8-8b3a-1c44-904b-b90351511341"],
 "/",
 Cell[BoxData[
 "Antihermitian"], "InlineCode",ExpressionUUID->
  "bb9957b6-1e04-1240-b2c8-baf7112d37f2"],
 " with respect to the complex indices."
}], "Item",
 CellChangeTimes->{{3.951859620914671*^9, 3.9518596275670185`*^9}, {
   3.954519843593357*^9, 3.9545198623567142`*^9}, 3.9553907302534904`*^9, {
