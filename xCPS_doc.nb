Cell[TextData[{
 Cell[BoxData[
 "MakeVertRule"], "InlineCode",ExpressionUUID->
  "8a65f489-ff27-a14c-9d3c-c2b6db3282e5"],
 " is the natural extension of ",
 Cell[BoxData[
 "MakeRule"], "InlineCode",ExpressionUUID->
  "5ec40d74-852b-fb4b-81df-df4b9aa4c208"],
 " and is independent of the rules generated for ",
 Cell[BoxData[
 "ExpandVertDiff"], "InlineCode",ExpressionUUID->
  "5303ab5d-0307-1d44-9857-60cc4fc9791b"],
 ". It only works if the LHS is a tensor with its indices in their natural \
place."
}], "Text",
