Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"ListVariationalRelationOf", "[", 
    RowBox[{"tensor", ",", " ", "option"}], "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"ca242388-95b5-9345-bb80-a81378a23132"],
 "\nIt returns the list of tensors variationally related to ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "74fbbd12-9b6e-184d-ab1f-60f81b8d59b7"],
 ".\n",
 StyleBox["\n",
  FontSize->5],
 "- Option:\n  \:2217 ",
 Cell[BoxData[
  RowBox[{"Directed", "\[RightArrow]", "Both"}]], "InlineCode",ExpressionUUID->
  "db2bf0ee-8659-a442-b847-4ea8e8b4ef35"],
 ": Since the graph is directed, this option controls which edges are taken \
into account."
}], "Text",
 CellFrame->{{1, 1}, {1, 1}},
 CellChangeTimes->{{3.952437183018958*^9, 3.9524372085839415`*^9}, {
   3.9524372818303075`*^9, 3.952437400808908*^9}, 3.9526904491775203`*^9, {
   3.953086717072216*^9, 3.953086744422722*^9}, 3.9544805056591763`*^9, {
   3.954505009170573*^9, 3.954505022966942*^9}, {3.954649773421836*^9, 
   3.9546497859023123`*^9}, {3.95465114842006*^9, 3.954651157760322*^9}, 
   3.9546666442743835`*^9, {3.9546666763861275`*^9, 3.9546666786754775`*^9}, 
   3.954667050909913*^9, {3.954758506050603*^9, 3.954758518361339*^9}, 
   3.9547589238892612`*^9, {3.9547594733585668`*^9, 3.9547594851821103`*^9}, {
   3.9559670077646365`*^9, 3.9559670142130175`*^9}, {3.9559670776816797`*^9, 
   3.95596708011017*^9}, {3.955967206740402*^9, 3.955967208236019*^9}, {
   3.956915519607234*^9, 3.9569155824475074`*^9}, 3.9578840186570616`*^9, {
   3.9578860622659483`*^9, 3.9578860631932774`*^9}, {3.9581566189089546`*^9, 
