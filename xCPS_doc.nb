Cell[TextData[{
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialPartialsOfTensor", "[", "tensor", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"ec69562f-f69c-2c4b-9fad-8acd05e487a0"],
 "\nIt returns the list of tensors representing partial derivatives where ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor", "'"}]}]], "InlineCode",ExpressionUUID->
  "7c593600-09e9-da42-ac65-7e2ac84c52c9"],
 " appears as one of the differentiation arguments.\n\n",
 Cell[BoxData[
  StyleBox[
   RowBox[{"PartialPartialsOfFunction", "[", "function", "]"}],
   FontWeight->"Bold",
   FontColor->RGBColor[
    0.5019607843137255, 0.5019607843137255, 0.5019607843137255]]], 
  "InlineCode",ExpressionUUID->"0624098c-170a-0840-9c14-2785078cbc7a"],
 "\nIt returns the list of ",
 Cell[BoxData[
 "PartialPartial"], "InlineCode",ExpressionUUID->
  "469e4473-7b9a-b244-b687-b0f6b998dabc"],
 " tensors defined using the scalar function ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"function", "'"}]}]], "InlineCode",ExpressionUUID->
  "4ce89a77-488f-a044-8ca4-2000500d69d3"],
