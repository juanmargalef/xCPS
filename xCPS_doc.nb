Cell[TextData[{
 "We see how ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"function", "'"}]}]], "InlineCode",ExpressionUUID->
  "512d50a2-0141-634b-9f64-898ee40b4c60"],
 " is supposed to depend on both ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"v1", "'"}]}]], "InlineCode",ExpressionUUID->
  "cffae929-40e9-8741-941f-1092cf35e123"],
 " and ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"tensor2", "'"}]}]], "InlineCode",ExpressionUUID->
  "0305e9b2-4bbd-5048-bba8-6ec6abda0fec"],
 " but the second partial derivative is only taken with respect to ",
 Cell[BoxData[
  RowBox[{"'", 
   RowBox[{"v1", "'"}]}]], "InlineCode",ExpressionUUID->
  "a889f81f-1d45-184a-9748-c3d57b831312"],
 " (the tensor which appeared already). This is solved indicating the \
depending fields when defining the function."
}], "Text",
 CellChangeTimes->{{3.956420685519741*^9, 3.9564207399322453`*^9}, {
  3.9564219689403324`*^9, 3.956421989722883*^9}, {3.956671453268038*^9, 
