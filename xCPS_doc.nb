Cell[BoxData[
 RowBox[{"vvf1", "=", 
  RowBox[{"\[Integral]", " ", 
   RowBox[{
    RowBox[{"(", 
     InterpretationBox[
      StyleBox[
       RowBox[{
        SubscriptBox["\[ScriptCapitalL]", "\[Xi]"], "\[Phi]"}],
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`xTensor`LieD[
       $CellContext`xi[$CellContext`a]][
       $CellContext`phi[]],
      Editable->False], ")"}], 
