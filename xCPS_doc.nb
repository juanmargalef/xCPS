Cell[TextData[{
 "Integrate ",
 StyleBox["xTerior",
  FontWeight->"Bold"],
 ". This is by far the trickiest extensions since this",
 " will require a bigraded product (one horizontal, for ",
 StyleBox["xTerior",
  FontWeight->"Bold"],
 ", and another vertical, for ",
 StyleBox["xCPS",
  FontWeight->"Bold"],
 ") and this has not been implemented in ",
