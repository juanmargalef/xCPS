Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BianchiContracted1", "=", 
      RowBox[{"MakeRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "e"}], "]"}], "@", 
           RowBox[{"RiemannLCDer", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "c"}], ",", 
             RowBox[{"-", "d"}], ",", "e"}], "]"}]}], ",", 
          RowBox[{"$RicciSign", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"LCDer", "[", 
               RowBox[{"-", "c"}], "]"}], "@", 
              RowBox[{"RicciLCDer", "[", 
               RowBox[{
                RowBox[{"-", "a"}], ",", 
                RowBox[{"-", "d"}]}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"LCDer", "[", 
               RowBox[{"-", "a"}], "]"}], "@", 
              RowBox[{"RicciLCDer", "[", 
               RowBox[{
                RowBox[{"-", "c"}], ",", 
                RowBox[{"-", "d"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
        RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"BianchiContracted2", "=", 
      RowBox[{"MakeRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"LCDer", "[", 
            RowBox[{"-", "b"}], "]"}], "@", 
           RowBox[{"RicciScalarLCDer", "[", "]"}]}], ",", 
          RowBox[{"2", 
           RowBox[{
            RowBox[{"LCDer", "[", 
             RowBox[{"-", "a"}], "]"}], "[", 
            RowBox[{"RicciLCDer", "[", 
             RowBox[{"a", ",", 
              RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"BianchiRiemann", "=", 
      RowBox[{"MakeRule", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RiemannLCDer", "[", 
           RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], ",", 
          RowBox[{
           RowBox[{"RiemannLCDer", "[", 
            RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "-", 
           RowBox[{"RiemannLCDer", "[", 
            RowBox[{"a", ",", "d", ",", "b", ",", "c"}], "]"}]}], ",", 
          RowBox[{"OrderedQ", "[", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ApplyBianchi", "[", "expr_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"expr", "//.", "BianchiContracted1"}], "//.", 
        "BianchiContracted2"}], "//.", "BianchiRiemann"}]}]}], "}"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
