Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Initial", " ", "definitions", " ", "explained", " ", "later"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$DefInfoQ", "=", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"DefConstantSymbol", "[", "dimen", "]"}], "\n", 
   RowBox[{"DefManifold", "[", 
    RowBox[{"M", ",", "dimen", ",", 
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "h", ",", 
       "i", ",", "j", ",", "k", ",", "l"}], "}"}]}], "]"}], "\n", 
   RowBox[{"DefMetric", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], ",", "Nabla", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<;\>\"", ",", "\"\<\[Del]\>\""}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PrintAs", "[", "RiemannNabla", "]"}], "^=", "\"\<Riem\>\""}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PrintAs", "[", "RicciNabla", "]"}], "^=", "\"\<Ric\>\""}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PrintAs", "[", "RicciScalarNabla", "]"}], "^=", "\"\<R\>\""}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"Phi", "[", "]"}], ",", "M", ",", 
     RowBox[{"PrintAs", "->", "\"\<\[CapitalPhi]\>\""}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Implode", "[", 
     RowBox[{
      RowBox[{"Nabla", "[", 
       RowBox[{"-", "a"}], "]"}], "[", 
      RowBox[{"Phi", "[", "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Implode", "[", 
     RowBox[{
      RowBox[{"Nabla", "[", 
       RowBox[{"-", "e"}], "]"}], "[", 
      RowBox[{"RiemannNabla", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"xi", "[", "a", "]"}], ",", "M", ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Xi]\>\""}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"DefScalarFunction", "[", 
    RowBox[{"F", ",", 
     RowBox[{"{", 
      RowBox[{"RiemannNabla", ",", "NablaRiemannNabla"}], "}"}]}], "]"}], "\n", 
   RowBox[{"DefScalarFunction", "[", 
    RowBox[{"L", ",", 
     RowBox[{"{", 
      RowBox[{"Phi", ",", "NablaPhi"}], "}"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BianchiRule", "=", 
     RowBox[{"MakeRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RiemannNabla", "[", 
          RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], ",", 
         RowBox[{
          RowBox[{"RiemannNabla", "[", 
           RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "-", 
          RowBox[{"RiemannNabla", "[", 
           RowBox[{"a", ",", "d", ",", "b", ",", "c"}], "]"}]}], ",", 
         RowBox[{"OrderedQ", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}]}], "}"}],
        ",", 
       RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BianchiContracted1", "=", 
     RowBox[{"MakeRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Nabla", "[", 
           RowBox[{"-", "e"}], "]"}], "@", 
          RowBox[{"RiemannNabla", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "c"}], ",", 
            RowBox[{"-", "d"}], ",", "e"}], "]"}]}], ",", 
         RowBox[{"$RicciSign", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Nabla", "[", 
              RowBox[{"-", "c"}], "]"}], "@", 
             RowBox[{"RicciNabla", "[", 
              RowBox[{
               RowBox[{"-", "a"}], ",", 
               RowBox[{"-", "d"}]}], "]"}]}], "-", 
            RowBox[{
             RowBox[{"Nabla", "[", 
              RowBox[{"-", "a"}], "]"}], "@", 
             RowBox[{"RicciNabla", "[", 
              RowBox[{
               RowBox[{"-", "c"}], ",", 
               RowBox[{"-", "d"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BianchiContracted2", "=", 
     RowBox[{"MakeRule", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Nabla", "[", 
           RowBox[{"-", "b"}], "]"}], "@", 
          RowBox[{"RicciScalarNabla", "[", "]"}]}], ",", 
         RowBox[{"2", 
          RowBox[{
           RowBox[{"Nabla", "[", 
            RowBox[{"-", "a"}], "]"}], "[", 
           RowBox[{"RicciNabla", "[", 
            RowBox[{"a", ",", 
             RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"MetricOn", "->", "All"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ApplyBianchi", "[", "expr_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"expr", "//.", "BianchiContracted1"}], "//.", 
      "BianchiContracted2"}], "//.", "BianchiRule"}]}]}]}]], "Input",
