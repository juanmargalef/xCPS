Cell[BoxData[
 RowBox[{
  RowBox[{"RotateGraph", "[", 
   RowBox[{"g_Graph", ",", "angle_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "coords", ",", "center", ",", "rotatedCoords", ",", "existingOpts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"coords", "=", 
      RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"center", "=", 
      RowBox[{"Mean", "[", "coords", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rotatedCoords", "=", 
      RowBox[{
       RowBox[{"RotationTransform", "[", 
        RowBox[{"angle", ",", "center"}], "]"}], "/@", "coords"}]}], ";", 
     RowBox[{"existingOpts", "=", 
      RowBox[{"FilterRules", "[", 
       RowBox[{
        RowBox[{"Options", "[", "g", "]"}], ",", 
        RowBox[{"Except", "[", "VertexCoordinates", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", 
       RowBox[{"EdgeList", "[", "g", "]"}], ",", 
       RowBox[{"VertexCoordinates", "->", "rotatedCoords"}], ",", 
       RowBox[{"Sequence", "@@", "existingOpts"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
